f_eval_tu(array<float> x) =>
    f_tu_0(x) + f_tu_1(x) + f_tu_2(x) + f_tu_3(x)

// ─── Session State ───────────────────────────────────────────────────────────
bool inEntry   = timeframe.isintraday ? not na(time(timeframe.period, entrySession, tz)) : true
bool inFlat    = timeframe.isintraday ? not na(time(timeframe.period, flatSession, tz)) : false
bool inOpening = timeframe.isintraday ? not na(time(timeframe.period, openingSession, tz)) : false
bool newDay    = barstate.isfirst or nz(dayofmonth(time, tz)) != nz(dayofmonth(time[1], tz)) or nz(month(time, tz)) != nz(month(time[1], tz))

var float openingHigh = na
var float openingLow  = na
var bool openingReady = false
var float sessionOpen = na
var float sessHlc3Sum = 0.0
var int   sessBarCnt  = 0
if newDay or na(sessionOpen)
    openingHigh  := na
    openingLow   := na
    openingReady := false
    sessionOpen  := open
    sessHlc3Sum  := hlc3
    sessBarCnt   := 1
else
    sessHlc3Sum  += hlc3
    sessBarCnt   += 1
if inOpening
    openingHigh := na(openingHigh) ? high : math.max(openingHigh, high)
    openingLow  := na(openingLow) ? low : math.min(openingLow, low)
if not inOpening and not na(openingHigh) and not na(openingLow)
    openingReady := true

// ─── Unconditional Continuous Series (Maintains ta.* History Buffers) ─────────
f_calc_series() =>
    float lr1 = close[1] > 0 ? math.log(close / close[1]) : 0.0
    [macdLine, macdSig, macdDiff] = ta.macd(close, 12, 26, 9)
    [bbMid, bbUp, bbLo] = ta.bb(close, 20, 2.0)
    float rh12 = ta.highest(high, 12)
    float rl12 = ta.lowest(low, 12)
    float rh36 = ta.highest(high, 36)
    float rl36 = ta.lowest(low, 36)
    float rv6  = nz(ta.stdev(lr1, 6, false)) * math.sqrt(6.0)
    float rv12 = nz(ta.stdev(lr1, 12, false)) * math.sqrt(12.0)
    float rv24 = nz(ta.stdev(lr1, 24, false)) * math.sqrt(24.0)
    float avgR12 = ta.sma(high - low, 12)
    [lr1, macdLine, macdSig, macdDiff, bbMid, bbUp, bbLo, rh12, rl12, rh36, rl36, rv6, rv12, rv24, avgR12]

f_fill_raw_features(
     array<float> x,
     float sessOpen,
     string tzName,
     float emaFast,
     float emaMid,
     float emaSlow,
     float rsiRaw,
     float atr,
     float lr1,
     float c2, float c3, float c6, float c12, float c24,
     float macdLine, float macdSig, float macdDiff,
     float bbMid, float bbUp, float bbLo,
     float rh12, float rl12, float rh36, float rl36,
     float rv6, float rv12, float rv24, float avgR12) =>
    float barRange = high - low
    float bbSpan = bbUp - bbLo
    float f15_rsi_14 = nz(rsiRaw, 50.0) / 100.0
    float f20_bb_pband = bbSpan > 0 ? (close - bbLo) / bbSpan : 0.5
    int minOfDay = hour(time, tzName) * 60 + minute(time, tzName)
    float sessMin = math.min(390.0, math.max(0.0, minOfDay - 570.0))
    int dowPy = math.min(4, math.max(0, dayofweek(time, tzName) - 2))

    array.set(x, 0,  nz(lr1))
    array.set(x, 1,  c2 > 0 ? math.log(close / c2) : 0.0)
    array.set(x, 2,  c3 > 0 ? math.log(close / c3) : 0.0)
    array.set(x, 3,  c6 > 0 ? math.log(close / c6) : 0.0)
    array.set(x, 4,  c12 > 0 ? math.log(close / c12) : 0.0)
    array.set(x, 5,  c24 > 0 ? math.log(close / c24) : 0.0)
    array.set(x, 6,  open > 0 ? math.log(close / open) : 0.0)
    array.set(x, 7,  close > 0 ? barRange / close : 0.0)
    array.set(x, 8,  barRange > 0 ? math.abs(close - open) / barRange : 0.0)
    array.set(x, 9,  barRange > 0 ? (high - math.max(open, close)) / barRange : 0.0)
    array.set(x, 10, barRange > 0 ? (math.min(open, close) - low) / barRange : 0.0)
    array.set(x, 11, close > 0 ? (close - emaFast) / close : 0.0)
    array.set(x, 12, close > 0 ? (close - emaMid) / close : 0.0)
    array.set(x, 13, close > 0 ? (close - emaSlow) / close : 0.0)
    array.set(x, 14, close > 0 ? (emaFast - emaMid) / close : 0.0)
    array.set(x, 15, f15_rsi_14)
    array.set(x, 16, close > 0 ? nz(macdLine) / close : 0.0)
    array.set(x, 17, close > 0 ? nz(macdSig) / close : 0.0)
    array.set(x, 18, close > 0 ? nz(macdDiff) / close : 0.0)
    array.set(x, 19, close > 0 ? nz(atr) / close : 0.0)
    array.set(x, 20, nz(f20_bb_pband, 0.5))
    array.set(x, 21, bbMid > 0 ? (bbSpan / bbMid) * 100.0 : 0.0)
    array.set(x, 22, close > 0 ? (rh12 - close) / close : 0.0)
    array.set(x, 23, close > 0 ? (close - rl12) / close : 0.0)
    array.set(x, 24, close > 0 ? (rh36 - close) / close : 0.0)
    array.set(x, 25, close > 0 ? (close - rl36) / close : 0.0)
    array.set(x, 26, nz(rv6))
    array.set(x, 27, nz(rv12))
    array.set(x, 28, nz(rv24))
    array.set(x, 29, avgR12 > 0 ? barRange / avgR12 : 1.0)
    array.set(x, 30, sessMin / 390.0)
    array.set(x, 31, math.sin(2.0 * math.pi * dowPy / 5.0))
    array.set(x, 32, math.cos(2.0 * math.pi * dowPy / 5.0))
    array.set(x, 33, sessMin <= 30.0 ? 1.0 : 0.0)
    array.set(x, 34, sessMin >= 360.0 ? 1.0 : 0.0)
    array.set(x, 35, sessOpen > 0 ? math.log(close / sessOpen) : 0.0)
    [f15_rsi_14, f20_bb_pband]

f_calc_v2(float pEmaFast, float pEmaMid, float pEmaSlow, float pDiPlus, float pDiMinus, float pAdx, float pVwap, float pAtr, float pRsi, float c3, float c6, float c12, float pOpenH, float pOpenL, bool pOpenReady, float pPrevH, float pPrevL, float pTrendAdx, bool pUseVwap, bool pUseOpenRng) =>
    bool tRegime = pAdx >= pTrendAdx and pEmaMid != 0 and math.abs(pEmaMid - pEmaSlow) / pEmaMid > 0.00015
    float ret3  = c3 > 0 ? close / c3 - 1.0 : 0.0
    float ret6  = c6 > 0 ? close / c6 - 1.0 : 0.0
    float ret12 = c12 > 0 ? close / c12 - 1.0 : 0.0
    float vwapDistAtr = pAtr > 0 and not na(pVwap) ? (close - pVwap) / pAtr : 0.0

    float tScore = 0.0
    tScore += pEmaFast > pEmaMid ? 0.40 : -0.40
    tScore += pEmaMid > pEmaSlow ? 0.70 : -0.70
    tScore += ret3 > 0 ? 0.30 : -0.30
    tScore += ret6 > 0 ? 0.25 : -0.25
    tScore += ret12 > 0 ? 0.65 : -0.65
    tScore += pDiPlus > pDiMinus ? 0.35 : -0.35
    tScore += pUseVwap ? (close > pVwap ? 0.45 : -0.45) : 0.0
    tScore += pUseOpenRng and pOpenReady ? (close > pOpenH ? 0.75 : close < pOpenL ? -0.75 : 0.0) : 0.0
    tScore += close > pPrevH ? 0.30 : close < pPrevL ? -0.30 : 0.0

    float rScore = 0.0
    rScore += vwapDistAtr < -0.90 ? 0.60 : vwapDistAtr > 0.90 ? -0.60 : 0.0
    rScore += pRsi < 32 ? 1.10 : pRsi > 68 ? -1.10 : 0.0
    rScore += close > pEmaFast ? 0.20 : -0.20
    rScore += pDiPlus > pDiMinus ? 0.15 : -0.15

    float rawScore = tRegime ? tScore : rScore
    float conf     = 1.0 / (1.0 + math.exp(-math.min(8.0, math.max(-8.0, math.abs(rawScore) * 0.65))))
    bool  v2L      = rawScore >= 2.20 and conf >= 0.65
    bool  v2S      = rawScore <= -2.20 and conf >= 0.65
    float v2N      = f_tanh(rawScore / 1.5)
    [tRegime, rawScore, v2L, v2S, v2N]

// ─── Indicators (Every Bar) & Gated ML Inference (Only Candidate Entry Bars) ─
emaFast = ta.ema(close, 9)
emaMid  = ta.ema(close, 21)
emaSlow = ta.ema(close, 50)
rsiRaw  = ta.rsi(close, 14)
atr     = ta.atr(14)
atrSlow = ta.sma(atr, slowAtrLen)
volRatio = atrSlow > 0 ? atr / atrSlow : na
[diPlus, diMinus, adx] = ta.dmi(14, 14)
// Cash SPX has zero/na volume on TradingView so ta.vwap() is always na; fall back to session TWAP matching Python.
rawVwap   = ta.vwap(hlc3)
twapValue = sessBarCnt > 0 ? sessHlc3Sum / sessBarCnt : hlc3
vwapValue = not na(rawVwap) ? rawVwap : twapValue

[lr1, macdLine, macdSig, macdDiff, bbMid, bbUp, bbLo, rh12, rl12, rh36, rl36, rv6, rv12, rv24, avgR12] = f_calc_series()
c2  = close[2]
c3  = close[3]
c6  = close[6]
c12 = close[12]
c24 = close[24]

priorDayHigh = request.security(syminfo.tickerid, "D", high[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
priorDayLow  = request.security(syminfo.tickerid, "D", low[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

volOk = not na(volRatio) and volRatio >= minVolRatio and volRatio <= maxVolRatio
ready = not na(atrSlow) and atrSlow > 0 and not na(vwapValue) and not na(adx)
bool canEnter = strategy.position_size == 0 and ready and volOk and inEntry and barstate.isconfirmed

var array<float> xRaw = array.new_float(36, 0.0)
bool  trendRegime = false
float mlR1        = na
float pCloseUp    = na
float calPTouch   = na
float mlScore     = na
float v2RawScore  = na
float hybridScore = na
bool  enterLong   = false
bool  enterShort  = false

if canEnter or barstate.islast
    [f15_rsi_14, f20_bb_pband] = f_fill_raw_features(xRaw, sessionOpen, tz, emaFast, emaMid, emaSlow, rsiRaw, atr, lr1, c2, c3, c6, c12, c24, macdLine, macdSig, macdDiff, bbMid, bbUp, bbLo, rh12, rl12, rh36, rl36, rv6, rv12, rv24, avgR12)
    mlR1        := f_eval_r1(xRaw)
    pCloseUp    := f_sigmoid(f_eval_cu(xRaw))
    float mlPath30 = f_eval_p30(xRaw)
    calPTouch   := f_platt(f_sigmoid(f_eval_tu(xRaw)))

    float r1Z      = f_tanh(mlR1 / 0.00005)
    float closeUpZ = f_tanh((pCloseUp - 0.5) * 6.0)
    float path30Z  = f_tanh(mlPath30 / 0.00015)
    mlScore     := 0.50 * r1Z + 0.35 * closeUpZ + 0.15 * path30Z

    [tReg, v2S_raw, v2L, v2S, v2N] = f_calc_v2(emaFast, emaMid, emaSlow, diPlus, diMinus, adx, vwapValue, atr, rsiRaw, c3, c6, c12, openingHigh, openingLow, openingReady, priorDayHigh, priorDayLow, trendAdx, useVwapFilter, useOpeningRange)
    trendRegime := tReg
    v2RawScore  := v2S_raw
    hybridScore := mlWeight * mlScore + adaptiveWeight * v2N

    if canEnter
        bool coupledLong  = mlR1 > 0.00008 and calPTouch >= 0.95 and f15_rsi_14 < 0.58 and f20_bb_pband < 0.85
        bool coupledShort = mlR1 < -0.00008 and f15_rsi_14 > 0.42 and f20_bb_pband > 0.15
        bool longMlConfirm  = (mlScore >= minMlConfirm) or (mlR1 > 0.0 and pCloseUp >= 0.505) or coupledLong
        bool shortMlConfirm = (mlScore <= -minMlConfirm) or (mlR1 < 0.0 and pCloseUp <= 0.495) or coupledShort
        bool mlVetoesLong  = (mlScore <= -0.10) or (mlR1 < -0.00003 and pCloseUp < 0.485)
        bool mlVetoesShort = (mlScore >= 0.10) or (mlR1 > 0.00003 and pCloseUp > 0.515)
        enterLong  := (hybridScore >= fusionThr or (v2L and longMlConfirm)) and longMlConfirm and not mlVetoesLong
        enterShort := (hybridScore <= -fusionThr or (v2S and shortMlConfirm)) and shortMlConfirm and not mlVetoesShort

// ─── Orders & ATR Brackets ───────────────────────────────────────────────────
int tpTicks = math.max(1, int(math.round(tpAtr * atr / syminfo.mintick)))
int slTicks = math.max(1, int(math.round(slAtr * atr / syminfo.mintick)))

if enterLong
    strategy.entry("Long", strategy.long, comment="HYB+LGBM LONG " + str.tostring(hybridScore, "#.##"))
    strategy.exit("Long bracket", "Long", profit=tpTicks, loss=slTicks)
if enterShort
    strategy.entry("Short", strategy.short, comment="HYB+LGBM SHORT " + str.tostring(hybridScore, "#.##"))
    strategy.exit("Short bracket", "Short", profit=tpTicks, loss=slTicks)

if strategy.position_size != 0
    int heldBars = bar_index - strategy.opentrades.entry_bar_index(0)
    if heldBars >= maxHoldBars
        strategy.close_all(comment="Max hold")
    if inFlat
        strategy.close_all(comment="Session flatten")

// ─── Plots & HUD ─────────────────────────────────────────────────────────────
plot(emaMid, "EMA 21", color=color.new(color.orange, 25))
plot(vwapValue, "Session VWAP", color=color.new(color.aqua, 10), linewidth=2)
plotshape(showSignals and enterLong, title="Hybrid Long", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="ML+")
plotshape(showSignals and enterShort, title="Hybrid Short", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="ML-")
bgcolor(strategy.position_size > 0 ? color.new(color.green, 93) : strategy.position_size < 0 ? color.new(color.red, 93) : na)

plot(mlR1 * 10000.0, "LGBM r_1 (bps)", display=display.data_window)
plot(pCloseUp, "LGBM P(close_up)", display=display.data_window)
plot(calPTouch, "Platt P(touch_up)", display=display.data_window)
plot(hybridScore, "Hybrid Score", display=display.data_window)

f_render_native_hud(table hud, bool tRegime, float r1, float pClose, float cTouch, float mScore, float vScore, float hScore) =>
    float wr = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : na
    float pf = strategy.grossloss < 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na
    table.cell(hud, 0, 0, "SPX v2 + Native LGBM", text_color=color.white, bgcolor=color.new(color.blue, 65))
    table.cell(hud, 1, 0, "45+35t", text_color=color.aqua, bgcolor=color.new(color.blue, 65))
    table.cell(hud, 0, 1, "Regime", text_color=color.silver)
    table.cell(hud, 1, 1, tRegime ? "TREND" : "RANGE", text_color=tRegime ? color.aqua : color.orange)
    table.cell(hud, 0, 2, "LGBM r_1 (bps)", text_color=color.silver)
    table.cell(hud, 1, 2, str.tostring(r1 * 10000.0, "#.##"), text_color=r1 >= 0 ? color.lime : color.red)
    table.cell(hud, 0, 3, "P(close_up)", text_color=color.silver)
    table.cell(hud, 1, 3, str.tostring(pClose * 100.0, "#.1") + "%", text_color=pClose >= 0.5 ? color.lime : color.red)
    table.cell(hud, 0, 4, "Platt P(touch_up)", text_color=color.silver)
    table.cell(hud, 1, 4, str.tostring(cTouch * 100.0, "#.1") + "%", text_color=color.white)
    table.cell(hud, 0, 5, "ML Score", text_color=color.silver)
    table.cell(hud, 1, 5, str.tostring(mScore, "#.###"), text_color=mScore >= 0 ? color.lime : color.red)
    table.cell(hud, 0, 6, "Adaptive v2 Score", text_color=color.silver)
    table.cell(hud, 1, 6, str.tostring(vScore, "#.##"), text_color=vScore >= 0 ? color.lime : color.red)
    table.cell(hud, 0, 7, "Hybrid Score", text_color=color.silver)
    table.cell(hud, 1, 7, str.tostring(hScore, "#.###"), text_color=hScore >= 0 ? color.lime : color.red)
    table.cell(hud, 0, 8, "Net P&L / trades", text_color=color.silver)
    table.cell(hud, 1, 8, str.tostring(strategy.netprofit, "#.##") + " / " + str.tostring(strategy.closedtrades), text_color=strategy.netprofit >= 0 ? color.lime : color.red)
    table.cell(hud, 0, 9, "Win rate / PF", text_color=color.silver)
    table.cell(hud, 1, 9, (na(wr) ? "n/a" : str.tostring(wr, "#.0") + "%") + " / " + (na(pf) ? "n/a" : str.tostring(pf, "#.00")), text_color=color.white)

var table hud = table.new(position.top_right, 2, 10, bgcolor=color.new(#0f172a, 15), border_color=color.new(#334155, 0), border_width=1)
if showHud and barstate.islast
    f_render_native_hud(hud, trendRegime, mlR1, pCloseUp, calPTouch, mlScore, v2RawScore, hybridScore)
