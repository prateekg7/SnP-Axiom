//@version=6
strategy(
     title="SPX Adaptive v2 + Trained MLP Neural Network ML [Native Pine]",
     shorttitle="SPX v2+MLP",
     overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     commission_type=strategy.commission.cash_per_order,
     commission_value=0.15,
     slippage=0,
     pyramiding=0,
     calc_on_every_tick=false,
     process_orders_on_close=false,
     max_bars_back=500)

// =============================================================================
// METHOD 3: NATIVE MULTILAYER PERCEPTRON (MLP NEURAL NETWORK) + ADAPTIVE v2
// -----------------------------------------------------------------------------
// Model: Deep Feedforward Neural Net (Layer 1 ReLU -> Layer 2 ReLU -> Output Linear)
// Weights mathematically pre-folded with StandardScaler parameters.
// Platt Calibrator: coef=0.51361892, intercept=1.40461530
// =============================================================================

grpSess = "Session"
tz              = input.string("America/New_York", "Session timezone", group=grpSess)
entrySession    = input.session("0935-1550:23456", "Entry window", group=grpSess)
flatSession     = input.session("1555-1600:23456", "Flatten window", group=grpSess)
openingSession  = input.session("0930-1000:23456", "Opening range window", group=grpSess)

grpHybrid = "Hybrid Fusion (Adaptive v2 + Multilayer Perceptron)"
mlWeight        = input.float(0.55, "ML weight", minval=0.0, maxval=1.0, step=0.05, group=grpHybrid)
adaptiveWeight  = input.float(0.45, "Adaptive v2 weight", minval=0.0, maxval=1.0, step=0.05, group=grpHybrid)
fusionThr       = input.float(0.32, "Hybrid entry threshold", minval=0.05, maxval=1.0, step=0.02, group=grpHybrid)
minMlConfirm    = input.float(0.04, "Minimum ML score confirmation", minval=0.0, maxval=0.5, step=0.01, group=grpHybrid)

grpRisk = "Risk Management"
tpAtr           = input.float(2.00, "Take profit (ATR)", minval=0.25, step=0.05, group=grpRisk)
slAtr           = input.float(1.00, "Stop loss (ATR)", minval=0.25, step=0.05, group=grpRisk)
maxHoldBars     = input.int(6, "Maximum holding bars", minval=1, maxval=24, group=grpRisk)

// ─── Technical Indicators ────────────────────────────────────────────────────
inEntryWindow = not na(time(timeframe.period, entrySession, tz))
isFlatTime    = not na(time(timeframe.period, flatSession, tz))
inOpening     = not na(time(timeframe.period, openingSession, tz))

emaFast = ta.ema(close, 9)
emaMid  = ta.ema(close, 21)
emaSlow = ta.ema(close, 50)
atr14   = ta.atr(14)
atrSlow = ta.sma(atr14, 156)
rsi14   = ta.rsi(close, 14)
[diPlus, diMinus, adx14] = ta.dmi(14, 14)

volRatio = (atrSlow > 0 ? atr14 / atrSlow : 1.0)
volOk    = volRatio >= 0.45 and volRatio <= 2.50

var float sessHlcSum = 0.0
var int   sessHlcCnt = 0
if ta.change(time("D", tz)) != 0
    sessHlcSum := 0.0
    sessHlcCnt := 0
sessHlcSum += (high + low + close) / 3.0
sessHlcCnt += 1
sessVwap = sessHlcSum / sessHlcCnt

var float orHigh = na
var float orLow  = na
var bool  orReady = false
if ta.change(time("D", tz)) != 0
    orHigh  := na
    orLow   := na
    orReady := false

if inOpening
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow  := na(orLow)  ? low  : math.min(orLow, low)
else if not na(orHigh)
    orReady := true

var float pdHigh = na
var float pdLow  = na
if ta.change(time("D", tz)) != 0
    pdHigh := high[1]
    pdLow  := low[1]

trendRegime = adx14 >= 20.0 and emaMid != 0 and (math.abs(emaMid - emaSlow) / emaMid > 0.00015)

// Adaptive v2 Score
float trendScore = 0.0
trendScore += (emaFast > emaMid ? 0.40 : -0.40)
trendScore += (emaMid > emaSlow ? 0.70 : -0.70)
trendScore += (close > close[3] ? 0.30 : -0.30)
trendScore += (close > close[6] ? 0.25 : -0.25)
trendScore += (close > close[12] ? 0.65 : -0.65)
trendScore += (diPlus > diMinus ? 0.35 : -0.35)
trendScore += (close > sessVwap ? 0.45 : -0.45)
if orReady
    trendScore += (close > orHigh ? 0.75 : (close < orLow ? -0.75 : 0.0))
trendScore += (close > pdHigh ? 0.30 : (close < pdLow ? -0.30 : 0.0))

float rangeScore = 0.0
float vwapDistAtr = atr14 > 0 ? (close - sessVwap) / atr14 : 0.0
if vwapDistAtr < -0.90
    rangeScore += 0.60
else if vwapDistAtr > 0.90
    rangeScore -= 0.60
if rsi14 < 32.0
    rangeScore += 1.10
else if rsi14 > 68.0
    rangeScore -= 1.10
rangeScore += (close > emaFast ? 0.20 : -0.20)
rangeScore += (diPlus > diMinus ? 0.15 : -0.15)

float v2Score = trendRegime ? trendScore : rangeScore
float v2Norm  = math.min(1.0, math.max(-1.0, v2Score / 3.50))

// ─── 36 Features ─────────────────────────────────────────────────────────────
float logRet1   = close[1] > 0 ? math.log(close / close[1]) : 0.0
float rollVol6  = nz(ta.stdev(logRet1, 6))
float rollVol12 = nz(ta.stdev(logRet1, 12))
float rollVol36 = nz(ta.stdev(logRet1, 36))

var array<float> x = array.new_float(36, 0.0)
f_update_features() =>
    array.set(x, 0, (close - close[1]) / math.max(close[1], 1.0))
    array.set(x, 1, (close - close[3]) / math.max(close[3], 1.0))
    array.set(x, 2, (close - close[6]) / math.max(close[6], 1.0))
    array.set(x, 3, (close - close[12]) / math.max(close[12], 1.0))
    float trRange = math.max(high - low, 1e-6)
    array.set(x, 4, trRange / close)
    array.set(x, 5, math.abs(close - open) / trRange)
    array.set(x, 6, (high - math.max(open, close)) / trRange)
    array.set(x, 7, (math.min(open, close) - low) / trRange)
    array.set(x, 8, (emaFast - emaMid) / close)
    array.set(x, 9, (emaMid - emaSlow) / close)
    array.set(x, 10, (close - emaFast) / close)
    array.set(x, 11, (close - emaMid) / close)
    array.set(x, 12, (close - emaSlow) / close)
    array.set(x, 13, (rsi14 - 50.0) / 50.0)
    array.set(x, 14, adx14 / 100.0)
    array.set(x, 15, diPlus / 100.0)
    array.set(x, 16, diMinus / 100.0)
    array.set(x, 17, (diPlus - diMinus) / 100.0)
    array.set(x, 18, atr14 / close)
    array.set(x, 19, volRatio)
    array.set(x, 20, (close - sessVwap) / math.max(atr14, 1.0))
    array.set(x, 21, orReady ? (close - orHigh) / math.max(atr14, 1.0) : 0.0)
    array.set(x, 22, orReady ? (close - orLow) / math.max(atr14, 1.0) : 0.0)
    array.set(x, 23, (close - pdHigh) / math.max(atr14, 1.0))
    array.set(x, 24, (close - pdLow) / math.max(atr14, 1.0))
    int tod = hour(time, tz) * 60 + minute(time, tz) - (9 * 60 + 30)
    array.set(x, 25, math.sin(2.0 * math.pi * tod / 390.0))
    array.set(x, 26, math.cos(2.0 * math.pi * tod / 390.0))
    array.set(x, 27, float(dayofweek(time, tz)))
    array.set(x, 28, rollVol6)
    array.set(x, 29, rollVol12)
    array.set(x, 30, rollVol36)
    array.set(x, 31, trendRegime ? 1.0 : 0.0)
    array.set(x, 32, (high - sessVwap) / math.max(atr14, 1.0))
    array.set(x, 33, (low - sessVwap) / math.max(atr14, 1.0))
    array.set(x, 34, math.abs(high - close[1]) / close)
    array.set(x, 35, math.abs(low - close[1]) / close)

// ─── Native MLP Neural Network Evaluators ────────────────────────────────────
f_mlp_eval_r1(array<float> x) =>
    float h1_0 = math.max(0.0, 0.68641 + -36.059 * array.get(x, 0) + -112 * array.get(x, 1) + -30.935 * array.get(x, 2) + 24.334 * array.get(x, 3) + -68.661 * array.get(x, 4) + -13.584 * array.get(x, 5) + 203.94 * array.get(x, 6) + -127.75 * array.get(x, 7) + 0.65008 * array.get(x, 8) + -0.22478 * array.get(x, 9) + 0.17998 * array.get(x, 10) + 99.416 * array.get(x, 11) + 71.859 * array.get(x, 12) + -34.68 * array.get(x, 13) + -85.333 * array.get(x, 14) + 0.67367 * array.get(x, 15) + 175.91 * array.get(x, 16) + 27.127 * array.get(x, 17) + -469.72 * array.get(x, 18) + 23.174 * array.get(x, 19) + -0.7078 * array.get(x, 20) + -0.32975 * array.get(x, 21) + -97.477 * array.get(x, 22) + -2.2513 * array.get(x, 23) + -9.0709 * array.get(x, 24) + 22.732 * array.get(x, 25) + -121.19 * array.get(x, 26) + -28.815 * array.get(x, 27) + -33.736 * array.get(x, 28) + 0.16738 * array.get(x, 29) + -0.63996 * array.get(x, 30) + -0.08488 * array.get(x, 31) + 0.26594 * array.get(x, 32) + 0.41044 * array.get(x, 33) + 0.82464 * array.get(x, 34) + 32.489 * array.get(x, 35))
    float h1_1 = math.max(0.0, -0.018379 + 248.39 * array.get(x, 0) + 148.04 * array.get(x, 1) + 1.9471 * array.get(x, 2) + -12.995 * array.get(x, 3) + -2.1271 * array.get(x, 4) + 7.9836 * array.get(x, 5) + 88.19 * array.get(x, 6) + -191.37 * array.get(x, 7) + -0.050211 * array.get(x, 8) + 0.62551 * array.get(x, 9) + 0.56886 * array.get(x, 10) + -143.43 * array.get(x, 11) + 66.224 * array.get(x, 12) + -33.514 * array.get(x, 13) + -221.03 * array.get(x, 14) + 0.21091 * array.get(x, 15) + 151.32 * array.get(x, 16) + -101.48 * array.get(x, 17) + 745.9 * array.get(x, 18) + 149.1 * array.get(x, 19) + -0.47638 * array.get(x, 20) + 0.026834 * array.get(x, 21) + 101.06 * array.get(x, 22) + 60.5 * array.get(x, 23) + 36.039 * array.get(x, 24) + -49.342 * array.get(x, 25) + -83.163 * array.get(x, 26) + 11.242 * array.get(x, 27) + 56.243 * array.get(x, 28) + -0.29994 * array.get(x, 29) + 0.44122 * array.get(x, 30) + -0.0076809 * array.get(x, 31) + 0.051328 * array.get(x, 32) + -0.31073 * array.get(x, 33) + -0.78338 * array.get(x, 34) + 28.064 * array.get(x, 35))
    float h1_2 = math.max(0.0, 1.9572 + 18.539 * array.get(x, 0) + 124.56 * array.get(x, 1) + -158.2 * array.get(x, 2) + -123.81 * array.get(x, 3) + -30.078 * array.get(x, 4) + 2.6295 * array.get(x, 5) + -190.22 * array.get(x, 6) + 426.12 * array.get(x, 7) + -0.057647 * array.get(x, 8) + -0.82856 * array.get(x, 9) + 0.065446 * array.get(x, 10) + -230.45 * array.get(x, 11) + -86.075 * array.get(x, 12) + 11.843 * array.get(x, 13) + 101.75 * array.get(x, 14) + -0.75223 * array.get(x, 15) + -236.63 * array.get(x, 16) + -199.75 * array.get(x, 17) + -109.03 * array.get(x, 18) + -299.14 * array.get(x, 19) + -0.65418 * array.get(x, 20) + 0.0086224 * array.get(x, 21) + -7.7871 * array.get(x, 22) + -26.805 * array.get(x, 23) + -36.264 * array.get(x, 24) + 7.1681 * array.get(x, 25) + 25.203 * array.get(x, 26) + -54.867 * array.get(x, 27) + -68.732 * array.get(x, 28) + -0.26015 * array.get(x, 29) + -0.41452 * array.get(x, 30) + -0.062142 * array.get(x, 31) + 0.25735 * array.get(x, 32) + -0.00050665 * array.get(x, 33) + 1.1061 * array.get(x, 34) + 31.753 * array.get(x, 35))
    float h1_3 = math.max(0.0, 0.50233 + 38.572 * array.get(x, 0) + 97.317 * array.get(x, 1) + 88.703 * array.get(x, 2) + -73.409 * array.get(x, 3) + -44.538 * array.get(x, 4) + 2.2092 * array.get(x, 5) + -34.596 * array.get(x, 6) + -54.448 * array.get(x, 7) + -1.0033 * array.get(x, 8) + -0.89973 * array.get(x, 9) + -0.90495 * array.get(x, 10) + 58.024 * array.get(x, 11) + -80.145 * array.get(x, 12) + 35.562 * array.get(x, 13) + 26.368 * array.get(x, 14) + 0.2611 * array.get(x, 15) + -230.53 * array.get(x, 16) + 74.708 * array.get(x, 17) + -271.43 * array.get(x, 18) + 292.44 * array.get(x, 19) + -0.53329 * array.get(x, 20) + 0.49649 * array.get(x, 21) + 69.963 * array.get(x, 22) + -14.756 * array.get(x, 23) + 50.071 * array.get(x, 24) + 16.391 * array.get(x, 25) + -6.7978 * array.get(x, 26) + -49.786 * array.get(x, 27) + -61.205 * array.get(x, 28) + 0.23017 * array.get(x, 29) + -0.095177 * array.get(x, 30) + -0.27719 * array.get(x, 31) + 0.29358 * array.get(x, 32) + 0.23568 * array.get(x, 33) + 0.50112 * array.get(x, 34) + 27.249 * array.get(x, 35))
    float h1_4 = math.max(0.0, -1.0511 + -172.34 * array.get(x, 0) + -39.419 * array.get(x, 1) + -94.055 * array.get(x, 2) + -74.231 * array.get(x, 3) + -42.368 * array.get(x, 4) + -42.369 * array.get(x, 5) + 132.09 * array.get(x, 6) + 186.01 * array.get(x, 7) + 0.45085 * array.get(x, 8) + 0.72662 * array.get(x, 9) + 0.99143 * array.get(x, 10) + -144.52 * array.get(x, 11) + 81.768 * array.get(x, 12) + 46.838 * array.get(x, 13) + -32.814 * array.get(x, 14) + 0.59747 * array.get(x, 15) + -72.983 * array.get(x, 16) + -33.656 * array.get(x, 17) + 172.42 * array.get(x, 18) + 80.435 * array.get(x, 19) + -0.41245 * array.get(x, 20) + -0.41255 * array.get(x, 21) + -72.849 * array.get(x, 22) + -3.8814 * array.get(x, 23) + -45.69 * array.get(x, 24) + -12.63 * array.get(x, 25) + 86.903 * array.get(x, 26) + 60.465 * array.get(x, 27) + -46.706 * array.get(x, 28) + 0.253 * array.get(x, 29) + -0.12662 * array.get(x, 30) + 0.14908 * array.get(x, 31) + -0.068888 * array.get(x, 32) + 0.12399 * array.get(x, 33) + 0.20414 * array.get(x, 34) + 9.0897 * array.get(x, 35))
    float h1_5 = math.max(0.0, -1.2917 + -158.13 * array.get(x, 0) + -150.01 * array.get(x, 1) + 128.56 * array.get(x, 2) + 26.713 * array.get(x, 3) + -27.695 * array.get(x, 4) + 34.462 * array.get(x, 5) + 184.63 * array.get(x, 6) + 86.481 * array.get(x, 7) + 0.75714 * array.get(x, 8) + -0.16088 * array.get(x, 9) + 0.81161 * array.get(x, 10) + 24.086 * array.get(x, 11) + 66.814 * array.get(x, 12) + 44.661 * array.get(x, 13) + 184.03 * array.get(x, 14) + 1.5706 * array.get(x, 15) + 141.27 * array.get(x, 16) + 141.09 * array.get(x, 17) + 656.94 * array.get(x, 18) + -381.03 * array.get(x, 19) + 0.62318 * array.get(x, 20) + -0.11743 * array.get(x, 21) + 53.705 * array.get(x, 22) + -40.968 * array.get(x, 23) + 1.9755 * array.get(x, 24) + 27.987 * array.get(x, 25) + -49.966 * array.get(x, 26) + 92.443 * array.get(x, 27) + -69.983 * array.get(x, 28) + 0.16948 * array.get(x, 29) + -0.049085 * array.get(x, 30) + -0.16121 * array.get(x, 31) + 0.20303 * array.get(x, 32) + 0.51715 * array.get(x, 33) + -0.38758 * array.get(x, 34) + 9.1198 * array.get(x, 35))
    float h1_6 = math.max(0.0, 0.79184 + -205.08 * array.get(x, 0) + 81.662 * array.get(x, 1) + 84.391 * array.get(x, 2) + -45.239 * array.get(x, 3) + 55.524 * array.get(x, 4) + -19.319 * array.get(x, 5) + 214.12 * array.get(x, 6) + 188.59 * array.get(x, 7) + -0.5121 * array.get(x, 8) + -0.86057 * array.get(x, 9) + -0.19836 * array.get(x, 10) + 166 * array.get(x, 11) + 110.17 * array.get(x, 12) + -64.803 * array.get(x, 13) + -218.38 * array.get(x, 14) + -1.9938 * array.get(x, 15) + 219.41 * array.get(x, 16) + 24.711 * array.get(x, 17) + -267.78 * array.get(x, 18) + 264.38 * array.get(x, 19) + 0.20228 * array.get(x, 20) + 0.45949 * array.get(x, 21) + 68.051 * array.get(x, 22) + 50.358 * array.get(x, 23) + 38.944 * array.get(x, 24) + 48.086 * array.get(x, 25) + 17.987 * array.get(x, 26) + -29.986 * array.get(x, 27) + -51.202 * array.get(x, 28) + -0.28818 * array.get(x, 29) + 0.31454 * array.get(x, 30) + 0.37839 * array.get(x, 31) + -0.37327 * array.get(x, 32) + 0.64122 * array.get(x, 33) + -0.76494 * array.get(x, 34) + -33.82 * array.get(x, 35))
