    float h2_3 = math.max(0.0, 0.20752 + 0.35751 * h1_0 + 0.12927 * h1_1 + -0.060102 * h1_2 + -0.064873 * h1_3 + 0.14342 * h1_4 + 0.24736 * h1_5 + 0.014438 * h1_6 + -0.20066 * h1_7 + 0.029061 * h1_8 + -0.043393 * h1_9 + 0.37004 * h1_10 + 0.50524 * h1_11 + 0.15343 * h1_12 + -0.36281 * h1_13 + 0.092153 * h1_14 + -0.08789 * h1_15 + 0.33176 * h1_16 + -0.2231 * h1_17 + 0.25542 * h1_18 + -0.21425 * h1_19 + 0.0912 * h1_20 + -0.0078708 * h1_21 + 0.29 * h1_22 + 0.025036 * h1_23)
    float h2_4 = math.max(0.0, 0.2956 + 0.10364 * h1_0 + -0.11515 * h1_1 + -0.32716 * h1_2 + 0.33249 * h1_3 + -0.20936 * h1_4 + -0.32982 * h1_5 + -0.30002 * h1_6 + 0.030041 * h1_7 + -0.14723 * h1_8 + -0.41577 * h1_9 + 0.35437 * h1_10 + 0.35991 * h1_11 + -0.095218 * h1_12 + 0.34451 * h1_13 + 0.3676 * h1_14 + -0.31466 * h1_15 + 0.35653 * h1_16 + -0.37534 * h1_17 + 0.27997 * h1_18 + 0.31408 * h1_19 + -0.42642 * h1_20 + -0.21142 * h1_21 + -0.15095 * h1_22 + -0.6219 * h1_23)
    float h2_5 = math.max(0.0, 0.076046 + 0.035102 * h1_0 + 0.39592 * h1_1 + 0.37532 * h1_2 + -0.19003 * h1_3 + 0.10467 * h1_4 + 0.44192 * h1_5 + -0.044465 * h1_6 + -0.3175 * h1_7 + 0.34976 * h1_8 + 0.059393 * h1_9 + -0.32098 * h1_10 + 0.174 * h1_11 + 0.24715 * h1_12 + -0.43409 * h1_13 + 0.40211 * h1_14 + -0.36505 * h1_15 + -0.056829 * h1_16 + -0.17653 * h1_17 + -0.24646 * h1_18 + 0.37223 * h1_19 + -0.17002 * h1_20 + 0.28501 * h1_21 + 0.38091 * h1_22 + -0.14866 * h1_23)
    float h2_6 = math.max(0.0, -0.053811 + 0.043115 * h1_0 + 0.25346 * h1_1 + 0.11231 * h1_2 + -0.27595 * h1_3 + 0.073913 * h1_4 + -0.1721 * h1_5 + 0.12371 * h1_6 + -0.07813 * h1_7 + 0.18032 * h1_8 + 0.28553 * h1_9 + 0.19914 * h1_10 + 0.23205 * h1_11 + -0.38638 * h1_12 + 0.20328 * h1_13 + 0.14921 * h1_14 + 0.32616 * h1_15 + 0.056486 * h1_16 + 0.16601 * h1_17 + 0.21518 * h1_18 + 0.26015 * h1_19 + 0.065061 * h1_20 + 0.25783 * h1_21 + 0.27195 * h1_22 + 0.050899 * h1_23)
    float h2_7 = math.max(0.0, 0.56787 + -0.1452 * h1_0 + -0.10008 * h1_1 + -0.21494 * h1_2 + 0.19316 * h1_3 + 0.3417 * h1_4 + 0.025253 * h1_5 + -0.09843 * h1_6 + 0.13818 * h1_7 + 0.25239 * h1_8 + 0.22909 * h1_9 + 0.32193 * h1_10 + 0.35695 * h1_11 + -0.10397 * h1_12 + 0.083811 * h1_13 + -0.089671 * h1_14 + 0.017261 * h1_15 + -0.2282 * h1_16 + -0.042724 * h1_17 + -0.20668 * h1_18 + 0.28445 * h1_19 + -0.24815 * h1_20 + 0.13758 * h1_21 + -0.32742 * h1_22 + 0.43165 * h1_23)
    float h2_8 = math.max(0.0, -0.093272 + -0.065247 * h1_0 + -0.1736 * h1_1 + 0.3305 * h1_2 + 0.32544 * h1_3 + -0.14955 * h1_4 + 0.091738 * h1_5 + 0.10676 * h1_6 + -0.060991 * h1_7 + -0.18917 * h1_8 + 0.28922 * h1_9 + -0.20977 * h1_10 + -0.0059542 * h1_11 + 0.056988 * h1_12 + 0.39065 * h1_13 + -0.064476 * h1_14 + -0.025614 * h1_15 + 0.41242 * h1_16 + -0.29095 * h1_17 + -0.29695 * h1_18 + 0.14027 * h1_19 + 0.39735 * h1_20 + 0.24777 * h1_21 + 0.35006 * h1_22 + 0.083065 * h1_23)
    float h2_9 = math.max(0.0, 0.54746 + 0.41623 * h1_0 + -0.080683 * h1_1 + 0.053127 * h1_2 + -0.022351 * h1_3 + -0.31469 * h1_4 + -0.23328 * h1_5 + 0.062973 * h1_6 + 0.291 * h1_7 + 0.16241 * h1_8 + 0.1717 * h1_9 + 0.020632 * h1_10 + 0.33913 * h1_11 + 0.27489 * h1_12 + 0.30644 * h1_13 + 0.12952 * h1_14 + 0.214 * h1_15 + -0.17139 * h1_16 + 0.45686 * h1_17 + 0.022745 * h1_18 + 0.065259 * h1_19 + 0.077583 * h1_20 + 0.28589 * h1_21 + -0.2659 * h1_22 + -0.13391 * h1_23)
    float h2_10 = math.max(0.0, 0.41229 + -0.26812 * h1_0 + 0.18343 * h1_1 + 0.32131 * h1_2 + -0.34142 * h1_3 + -0.1822 * h1_4 + -0.11935 * h1_5 + 0.26823 * h1_6 + -0.19614 * h1_7 + -0.026534 * h1_8 + 0.20614 * h1_9 + 0.28058 * h1_10 + -0.25242 * h1_11 + -0.19316 * h1_12 + 0.49604 * h1_13 + -0.27645 * h1_14 + -0.20814 * h1_15 + 0.39034 * h1_16 + 0.40759 * h1_17 + 0.12644 * h1_18 + -0.33251 * h1_19 + 0.11072 * h1_20 + 0.17484 * h1_21 + -0.22086 * h1_22 + 0.092874 * h1_23)
    float h2_11 = math.max(0.0, -0.51216 + -0.41724 * h1_0 + -0.16887 * h1_1 + 0.32311 * h1_2 + -0.10117 * h1_3 + 0.31134 * h1_4 + 0.14977 * h1_5 + 0.35502 * h1_6 + -0.31191 * h1_7 + -0.34907 * h1_8 + 0.32481 * h1_9 + -0.37803 * h1_10 + 0.10317 * h1_11 + 0.13489 * h1_12 + -0.10845 * h1_13 + -0.36484 * h1_14 + 0.31469 * h1_15 + 0.23899 * h1_16 + 0.32805 * h1_17 + 0.060754 * h1_18 + -0.038873 * h1_19 + 0.044081 * h1_20 + 0.2997 * h1_21 + 0.16552 * h1_22 + 0.081609 * h1_23)
    float out = 0.51819 + -0.32186 * h2_0 + 0.32112 * h2_1 + -0.53265 * h2_2 + 0.19009 * h2_3 + -0.32233 * h2_4 + 0.21744 * h2_5 + -0.56618 * h2_6 + 0.61945 * h2_7 + 0.57327 * h2_8 + 0.74045 * h2_9 + 0.46791 * h2_10 + -0.61059 * h2_11
    out

f_sigmoid(float z) => 1.0 / (1.0 + math.exp(-math.max(-20.0, math.min(20.0, z))))

// ─── Execution ───────────────────────────────────────────────────────────────
f_update_features()

float ml_r1 = f_mlp_eval_r1(x)
float ml_cu_raw = f_mlp_eval_cu(x)
float ml_p30 = f_mlp_eval_p30(x)
float ml_tu_raw = f_mlp_eval_tu(x)

float p_close_up = f_sigmoid(ml_cu_raw)
float raw_touch  = f_sigmoid(ml_tu_raw)
float platt_touch = f_sigmoid(0.51361892 * math.log(math.max(0.0001, math.min(0.9999, raw_touch)) / (1.0 - math.max(0.0001, math.min(0.9999, raw_touch)))) + 1.40461530)

float ml_score = 0.50 * (p_close_up - 0.50) * 4.0 + 0.30 * math.min(2.0, math.max(-2.0, ml_r1 * 2500.0)) + 0.20 * math.min(2.0, math.max(-2.0, ml_p30 * 1000.0))
float hybridScore = mlWeight * ml_score + adaptiveWeight * v2Norm

canEnter = inEntryWindow and volOk

if canEnter and hybridScore >= fusionThr and ml_score >= minMlConfirm
    strategy.entry("MLP_Long", strategy.long)
if canEnter and hybridScore <= -fusionThr and ml_score <= -minMlConfirm
    strategy.entry("MLP_Short", strategy.short)

float tpPoints = tpAtr * atr14
float slPoints = slAtr * atr14

strategy.exit("Exit_MLP_Long", "MLP_Long", profit=tpPoints/syminfo.mintick, loss=slPoints/syminfo.mintick)
strategy.exit("Exit_MLP_Short", "MLP_Short", profit=tpPoints/syminfo.mintick, loss=slPoints/syminfo.mintick)

var int barsHeld = 0
if strategy.position_size != 0
    barsHeld += 1
else
    barsHeld := 0

if barsHeld >= maxHoldBars or isFlatTime
    strategy.close_all("Hold_Timeout_Or_EOD")

// Visual HUD
var table hud = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)
if barstate.islast
    table.cell(hud, 0, 0, "Model", text_color=color.white)
    table.cell(hud, 1, 0, "Multilayer Perceptron (MLP)", text_color=color.yellow)
    table.cell(hud, 0, 1, "Hybrid Score", text_color=color.white)
    table.cell(hud, 1, 1, str.tostring(hybridScore, "#.###"), text_color=hybridScore >= 0.32 ? color.green : (hybridScore <= -0.32 ? color.red : color.gray))
    table.cell(hud, 0, 2, "ML Score", text_color=color.white)
    table.cell(hud, 1, 2, str.tostring(ml_score, "#.###"), text_color=color.aqua)
    table.cell(hud, 0, 3, "P(Close UP)", text_color=color.white)
    table.cell(hud, 1, 3, str.tostring(p_close_up * 100, "#.#") + "%", text_color=color.white)
    table.cell(hud, 0, 4, "Regime", text_color=color.white)
    table.cell(hud, 1, 4, trendRegime ? "TREND" : "RANGE", text_color=trendRegime ? color.green : color.orange)
    table.cell(hud, 0, 5, "Position", text_color=color.white)
    table.cell(hud, 1, 5, strategy.position_size > 0 ? "LONG" : (strategy.position_size < 0 ? "SHORT" : "FLAT"), text_color=strategy.position_size > 0 ? color.green : (strategy.position_size < 0 ? color.red : color.silver))
