//@version=6
strategy(
     title="SPX Adaptive v2 + Full Python ML Replay [All 13 LGBM + Open-Jev]",
     shorttitle="SPX ML Replay",
     overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     commission_type=strategy.commission.cash_per_order,
     commission_value=0.15,
     slippage=1,
     pyramiding=0,
     calc_on_every_tick=false,
     process_orders_on_close=false)

// =============================================================================
// OPTION B: 100% EXACT PYTHON ML SIGNAL REPLAY IN TRADINGVIEW
// -----------------------------------------------------------------------------
// Generated directly by `SPXAdaptiveV2MLStrategy` using ALL trained artifacts:
//   - LightGBM SHA256   : 194f26e7590c0fe4... (13 heads, 1300 trees)
//   - Platt SHA256      : 7427225e19504fa8...
//   - Conformal SHA256  : 9838ccae046ed1c1... (q_error=0.001022)
//   - Open-Jev SHA256   : e516de82a9650523... (1,022,805 PyTorch params)
// Exported window (UTC): 2026-10-19 17:30:00+00:00 -> 2026-11-09 20:55:00+00:00
// Bar counts in slice  : LONG=250, SHORT=115, HOLD=835 (467 emitted state rows)
// Apply on a 5m SPX / SPY / ES1! chart within the exported date window.
// =============================================================================

grpCtrl = "Replay Controls"
maxHoldBars     = input.int(12, "Maximum holding bars", minval=1, maxval=36, group=grpCtrl)
closeOnHold     = input.bool(true, "Exit active position when Python switches to HOLD", group=grpCtrl)
flatSession     = input.session("1555-1600:23456", "Flatten window (ET)", group=grpCtrl)
showSignals     = input.bool(true, "Show ML replay markers", group=grpCtrl)
showHud         = input.bool(true, "Show replay HUD", group=grpCtrl)

f_push_ints(array<int> dst, string csv) =>
    parts = str.split(csv, ",")
    for i = 0 to array.size(parts) - 1
        s = array.get(parts, i)
        if str.length(s) > 0
            array.push(dst, int(str.tonumber(s)))

f_push_floats(array<float> dst, string csv) =>
    parts = str.split(csv, ",")
    for i = 0 to array.size(parts) - 1
        s = array.get(parts, i)
        if str.length(s) > 0
            array.push(dst, str.tonumber(s))

var array<int>   sigTs     = array.new_int(0)
var array<int>   sigAct    = array.new_int(0)
var array<float> sigTpPts  = array.new_float(0)
var array<float> sigSlPts  = array.new_float(0)
var array<float> sigR1Bps  = array.new_float(0)
var array<float> sigPClose = array.new_float(0)

