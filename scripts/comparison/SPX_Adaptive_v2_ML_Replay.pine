if barstate.isfirst
    f_ld_0(sigTs)
    f_ld_1(sigTs)
    f_ld_2(sigAct)
    f_ld_3(sigTpPts)
    f_ld_4(sigSlPts)
    f_ld_5(sigR1Bps)
    f_ld_6(sigPClose)

// Binary-search cursor across exported signals sorted chronologically
var int cursor = 0
int barSec = int(time / 1000)
int nSigs  = array.size(sigTs)
while cursor < nSigs and array.get(sigTs, cursor) < barSec
    cursor += 1

bool matched = cursor < nSigs and math.abs(array.get(sigTs, cursor) - barSec) <= 60
int sigAction = matched ? array.get(sigAct, cursor) : 0
float tpPts = matched ? array.get(sigTpPts, cursor) : na
float slPts = matched ? array.get(sigSlPts, cursor) : na
float mlR1Bps = matched ? array.get(sigR1Bps, cursor) : na
float pClosePct = matched ? array.get(sigPClose, cursor) : na

var int matchedCount = 0
if barstate.isconfirmed and matched
    matchedCount += 1

inFlat = not na(time(timeframe.period, flatSession, "America/New_York"))
int tpTicks = not na(tpPts) ? math.max(1, int(math.round(tpPts / syminfo.mintick))) : 30
int slTicks = not na(slPts) ? math.max(1, int(math.round(slPts / syminfo.mintick))) : 15

bool enterLong  = barstate.isconfirmed and matched and sigAction == 1 and strategy.position_size <= 0
bool enterShort = barstate.isconfirmed and matched and sigAction == -1 and strategy.position_size >= 0

if enterLong
    if strategy.position_size < 0
        strategy.close("Short", comment="Flip to Long")
    strategy.entry("Long", strategy.long, comment="PY+JEV LONG r1=" + str.tostring(mlR1Bps, "#.##") + "bps")
    strategy.exit("Long bracket", "Long", profit=tpTicks, loss=slTicks)

if enterShort
    if strategy.position_size > 0
        strategy.close("Long", comment="Flip to Short")
    strategy.entry("Short", strategy.short, comment="PY+JEV SHORT r1=" + str.tostring(mlR1Bps, "#.##") + "bps")
    strategy.exit("Short bracket", "Short", profit=tpTicks, loss=slTicks)

if strategy.position_size != 0
    if closeOnHold and matched and sigAction == 0
        strategy.close_all(comment="Python HOLD")
    int heldBars = bar_index - strategy.opentrades.entry_bar_index(0)
    if heldBars >= maxHoldBars
        strategy.close_all(comment="Max hold")
    if inFlat
        strategy.close_all(comment="Session flatten")

plotshape(showSignals and enterLong, title="Python ML Long", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="JEV+")
plotshape(showSignals and enterShort, title="Python ML Short", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="JEV-")
bgcolor(strategy.position_size > 0 ? color.new(color.green, 93) : strategy.position_size < 0 ? color.new(color.red, 93) : na)

var table hud = table.new(position.top_right, 2, 7, bgcolor=color.new(#0f172a, 15), border_color=color.new(#334155, 0), border_width=1)
if showHud and barstate.islast
    float wr = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : na
    float pf = strategy.grossloss < 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na
    table.cell(hud, 0, 0, "SPX Full ML Replay", text_color=color.white, bgcolor=color.new(color.teal, 55))
    table.cell(hud, 1, 0, "Open-Jev + 13LGBM", text_color=color.aqua, bgcolor=color.new(color.teal, 55))
    table.cell(hud, 0, 1, "Matched bars", text_color=color.silver)
    table.cell(hud, 1, 1, str.tostring(matchedCount) + " / " + str.tostring(nSigs), text_color=matchedCount > 0 ? color.lime : color.orange)
    table.cell(hud, 0, 2, "Last matched r_1", text_color=color.silver)
    table.cell(hud, 1, 2, na(mlR1Bps) ? "outside slice" : str.tostring(mlR1Bps, "#.##") + " bps", text_color=color.white)
    table.cell(hud, 0, 3, "Last P(close_up)", text_color=color.silver)
    table.cell(hud, 1, 3, na(pClosePct) ? "--" : str.tostring(pClosePct, "#.1") + "%", text_color=color.white)
    table.cell(hud, 0, 4, "Net P&L / trades", text_color=color.silver)
    table.cell(hud, 1, 4, str.tostring(strategy.netprofit, "#.##") + " / " + str.tostring(strategy.closedtrades), text_color=strategy.netprofit >= 0 ? color.lime : color.red)
    table.cell(hud, 0, 5, "Win rate / PF", text_color=color.silver)
    table.cell(hud, 1, 5, (na(wr) ? "n/a" : str.tostring(wr, "#.0") + "%") + " / " + (na(pf) ? "n/a" : str.tostring(pf, "#.00")), text_color=color.white)
    table.cell(hud, 0, 6, "Slice coverage", text_color=color.silver)
    table.cell(hud, 1, 6, "2026-10-19..2026-11-09", text_color=color.silver)
