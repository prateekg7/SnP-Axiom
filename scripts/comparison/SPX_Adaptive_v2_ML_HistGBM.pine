    acc += (x3 <= -0.01108648 ? (x7 <= 0.003802632 ? (x1 <= -0.002157364 ? 2.29593e-05 : -7.0778e-05) : 0.000136366) : (x0 <= -0.004011465 ? (x10 <= 0.07011686 ? -0.00013285 : 6.88529e-06) : (x21 <= 3.900713 ? (x19 <= 0.005694248 ? (x26 <= 0.01405294 ? -2.41158e-08 : 7.03207e-05) : 5.05504e-05) : (x0 <= 0.0008886513 ? 1.97005e-05 : -0.000152424))))
    acc += (x4 <= 0.01422566 ? (x12 <= 0.009101791 ? (x19 <= 0.005694248 ? (x18 <= -0.0006769749 ? (x23 <= 0.001409084 ? -2.42107e-06 : -3.84709e-05) : (x7 <= 0.005836936 ? 3.63712e-07 : -5.94647e-05)) : (x3 <= -0.001017702 ? 0.000164215 : -0.000122363)) : -9.45868e-05) : (x10 <= 0.247012 ? (x0 <= 0.001223291 ? 3.78117e-05 : -9.44337e-05) : 0.000111265))
    acc += (x6 <= -0.001099763 ? (x2 <= 0.0005615536 ? (x6 <= -0.002085713 ? (x8 <= 0.6283186 ? 0.000162776 : (x35 <= -0.01718787 ? -9.94077e-05 : 8.42318e-06)) : (x3 <= -0.005044628 ? (x8 <= 0.5960396 ? -0.000112738 : -1.74265e-05) : (x10 <= 0.113354 ? -1.20724e-05 : 5.01448e-06))) : (x2 <= 0.002837497 ? (x25 <= 0.005153418 ? (x23 <= 0.002628278 ? -6.05462e-05 : 2.19026e-05) : -0.000114123) : 1.42174e-05)) : (x12 <= -0.009964045 ? 4.24685e-05 : (x17 <= -0.004984109 ? -7.59578e-05 : (x19 <= 0.004317277 ? (x12 <= -0.006677815 ? -3.29451e-05 : 5.25306e-07) : (x0 <= 0.001278983 ? 0.000175779 : -1.79762e-05)))))
    acc += (x5 <= -0.02140467 ? (x25 <= 0.002981604 ? (x23 <= 0.0005845993 ? 4.73133e-05 : -8.63523e-05) : 9.81772e-05) : (x17 <= -0.004984109 ? -0.000104693 : (x19 <= 0.005694248 ? (x22 <= 0.006996878 ? (x26 <= 0.01112897 ? 2.31613e-07 : 5.41949e-05) : (x30 <= 0.7371795 ? -4.56679e-06 : -4.43324e-05)) : (x3 <= -0.002370992 ? 0.000194861 : (x20 <= 0.7895347 ? -0.000141403 : 7.4898e-05)))))
    acc += (x10 <= 0.5957447 ? (x25 <= 0.02767352 ? (x19 <= 0.005694248 ? (x19 <= 0.002708082 ? (x17 <= -0.003299349 ? 2.44371e-05 : -4.61104e-07) : (x20 <= -0.01111724 ? 6.1657e-05 : -2.6566e-05)) : 6.81041e-05) : (x15 <= 0.6585864 ? -0.000154789 : 7.21375e-05)) : (x27 <= 0.01131762 ? (x6 <= -0.0003412314 ? (x30 <= 0.6217949 ? (x6 <= -0.0004526693 ? -8.2716e-06 : 4.30627e-05) : 6.73582e-05) : (x6 <= 0.0004549509 ? (x19 <= 0.002312858 ? 2.53731e-06 : 4.48316e-05) : -3.83126e-05)) : 0.00013609))
    acc

f_eval_r1(array<float> x) =>
    1.51726e-06 + (f_r1_0(x) + f_r1_1(x))

