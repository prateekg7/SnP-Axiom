//@version=6
strategy(
     title="SPX Adaptive Online-Learning Strategy [Regime-Aware]",
     shorttitle="SPX AI",
     overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     commission_type=strategy.commission.cash_per_order,
     commission_value=0.15,
     slippage=1,
     calc_on_every_tick=false,
     process_orders_on_close=false,
     max_bars_back=600
     )

// =============================================================================
// WHAT THIS DOES
// -----------------------------------------------------------------------------
// 1. ONLINE LOGISTIC REGRESSION trained inside Pine, bar by bar. Every closed bar:
//      a) the sample from H bars ago gets its true label (triple-barrier outcome),
//      b) weights take one SGD step on that sample (older data fades out),
//      c) a fresh prediction is made with the just-updated weights.
//    => The model adapts to live data, and the backtest is genuinely
//       walk-forward: every prediction uses only labels that were already known.
// 2. REGIME-SPECIFIC WEIGHTS: trending vs choppy (Kaufman efficiency ratio vs its
//    own rolling median - no fixed threshold). Each regime learns its own rules,
//    so momentum can be learned in one and mean-reversion in the other.
// 3. VOLATILITY-SCALED everything: features, barriers, TP and SL are in ATR units.
// 4. SELF-MONITORING: live hit-rate of confident calls is tracked in "shadow"
//    mode. If it degrades, trading pauses (learning continues) and the learning
//    rate is boosted; trading resumes automatically when the model recovers.
// 5. NO REPAINT: everything is computed on closed bars, no request.security,
//    orders fill at the NEXT bar open.
//
// Chart: SPX / ES1! / SPY, 5-minute, regular hours. Keep calc_on_every_tick OFF.
// Other assets (NIFTY, gold, crypto): session times are read in the chosen
// "Session timezone" (default Auto = the symbol's own exchange timezone).
// =============================================================================

// --- Inputs ------------------------------------------------------------------
grp_m = "Online Model"
H            = input.int(6, "Horizon (bars)", minval=2, maxval=24, group=grp_m, tooltip="Prediction & max holding horizon. 6 bars = 30 min on 5m")
label_k      = input.float(1.0, "Barrier width for labels (x ATR)", minval=0.5, step=0.25, group=grp_m, tooltip="Training label: did price touch +k*ATR or -k*ATR first within H bars?")
lr           = input.float(0.02, "Learning rate", minval=0.001, maxval=0.2, step=0.005, group=grp_m)
half_life_d  = input.float(10.0, "Memory half-life (trading days)", minval=2.0, maxval=60.0, group=grp_m, tooltip="Old samples lose half their influence after this many days. Shorter = adapts faster, noisier")
min_samples  = input.int(300, "Min training samples per regime", minval=50, group=grp_m, tooltip="No signals from a regime model until it has seen this many labeled samples")
zlen         = input.int(200, "Feature z-score window", minval=50, group=grp_m, tooltip="Rolling standardisation so features adapt to the current volatility level")
atr_len      = input.int(14, "ATR length", minval=5, group=grp_m)

grp_t = "Trading"
conf_floor   = input.float(0.51, "Minimum confidence floor", minval=0.505, maxval=0.80, step=0.005, group=grp_t, tooltip="Absolute minimum P(up) or P(down) to ever trade")
conf_pctile  = input.int(70, "Trade only above this confidence percentile", minval=0, maxval=99, group=grp_t, tooltip="Adaptive threshold: confidence must rank in the top (100 - x)% of the last 5 days. Lower = more trades")
tp_mult      = input.float(1.0, "Take-profit (x ATR)", minval=0.25, step=0.25, group=grp_t, tooltip="Model is trained on symmetric barriers. Keep TP and SL near label_k unless you re-validate")
sl_mult      = input.float(1.0, "Stop-loss (x ATR)", minval=0.25, step=0.25, group=grp_t)

grp_r = "Regime & Safety"
er_len       = input.int(20, "Efficiency-ratio length", minval=5, group=grp_r)
vol_hi       = input.float(2.2, "Stand aside if ATR > x * slow ATR", minval=1.2, step=0.1, group=grp_r, tooltip="Volatility shock filter (news spikes, crashes)")
vol_lo       = input.float(0.4, "Stand aside if ATR < x * slow ATR", minval=0.1, maxval=1.0, step=0.05, group=grp_r, tooltip="Dead tape: costs dominate")
health_len   = input.int(60, "Health window (confident calls)", minval=20, group=grp_r)
health_min   = input.float(0.50, "Pause trading if hit-rate below", minval=0.40, maxval=0.60, step=0.01, group=grp_r)
health_warm  = input.int(30, "Calls needed before health check", minval=10, group=grp_r)

grp_s = "Sessions"
tz_in           = input.string("Auto", "Session timezone", options=["Auto", "America/New_York", "Asia/Kolkata", "Etc/UTC", "Europe/London", "America/Chicago"], group=grp_s, tooltip="Timezone the session strings below are read in. Auto = the symbol's exchange timezone (CME futures are mapped to New York, so US behaviour is unchanged). For NIFTY use Asia/Kolkata and set the windows to e.g. 0930-1520 / 1520-1525")
entry_session   = input.session("0935-1520:23456", "Entry window", group=grp_s)
flatten_session = input.session("1550-1555:23456", "Flatten bar (order fills at next open)", group=grp_s, tooltip="Close issued at the close of the 15:50 bar fills at the 15:55 open")
show_hud        = input.bool(true, "Show HUD", group=grp_s)

// --- Constants ---------------------------------------------------------------
NF = 9                 // number of features
NC = NF + 4            // history columns: features | valid | regime | prediction | threshold
bpd = 390.0 / (timeframe.in_seconds() / 60.0)
decay = math.pow(0.5, 1.0 / math.max(1.0, half_life_d * bpd / 2.0))   // /2: two regimes share updates
feat_warm = 6          // bars into the day before features are valid (avoid overnight gap contamination)

// --- Session bookkeeping -----------------------------------------------------
string tz = tz_in == "Auto" ? (syminfo.timezone == "America/Chicago" ? "America/New_York" : syminfo.timezone) : tz_in
is_new_day = ta.change(time("D")) != 0
var int bar_of_day = 0
bar_of_day := is_new_day ? 0 : bar_of_day + 1
var float day_open = na
if is_new_day or na(day_open)
    day_open := open
in_entry = not na(time(timeframe.period, entry_session, tz))
is_flatten = not na(time(timeframe.period, flatten_session, tz))

// --- Indicators --------------------------------------------------------------
a = ta.atr(atr_len)
a_slow = ta.sma(a, 390)
vol_ratio = a / a_slow
ema21 = ta.ema(close, 21)
rsi_v = ta.rsi(close, 14)
[bb_m, bb_u, bb_l] = ta.bb(close, 20, 2.0)
bb_r = bb_u - bb_l
[macd_l, macd_s, macd_h] = ta.macd(close, 12, 26, 9)

// Regime: efficiency ratio vs its own rolling median (adaptive, no magic number)
er_raw = math.abs(close - close[er_len]) / math.max(math.sum(math.abs(ta.change(close)), er_len), 1e-9)
er = ta.ema(er_raw, 5)
er_med = ta.median(er, 390)
reg = (not na(er_med) and er > er_med) ? 1 : 0     // 1 = trending, 0 = choppy

// --- Features (all ATR-normalised, then rolling z-scored) ---------------------
f_z(x) =>
    m = ta.sma(x, zlen)
    s = ta.stdev(x, zlen)
    s > 1e-9 ? math.max(-3.0, math.min(3.0, (x - m) / s)) : 0.0

a_ok = math.max(nz(a), 1e-6)
z1 = f_z((close - nz(close[1], close)) / a_ok)                 // 1-bar momentum
z2 = f_z((close - nz(close[3], close)) / a_ok)                 // 3-bar momentum
z3 = f_z((close - nz(close[6], close)) / a_ok)                 // 6-bar momentum
z4 = f_z((close - ema21) / a_ok)                               // stretch from EMA21
z5 = f_z((rsi_v - 50.0) / 50.0)                                // RSI
z6 = f_z(bb_r > 0 ? (close - bb_l) / bb_r - 0.5 : 0.0)         // Bollinger %B
z7 = f_z(macd_h / a_ok)                                        // MACD histogram
z8 = f_z(high > low ? (close - low) / (high - low) - 0.5 : 0.0) // close location in bar
z9 = f_z((close - day_open) / a_ok)                            // distance from session open

feat_ok = bar_of_day >= feat_warm and not na(a) and bar_index > zlen + 30

// --- Model state -------------------------------------------------------------
var w = array.new_float(2 * (NF + 1), 0.0)          // per-regime weights (+ bias last)
var n_s = array.new_int(2, 0)                       // labeled samples seen per regime
var hist = matrix.new<float>(H + 1, NC, 0.0)        // ring buffer of last H+1 bars
var float health = 0.5
var int conf_n = 0
var cal_hit = array.new_float(4, 0.5)               // calibration buckets (EMA hit-rate)
var cal_n = array.new_int(4, 0)

f_sig(z) => 1.0 / (1.0 + math.exp(-math.max(-20.0, math.min(20.0, z))))

f_logit(array<float> wts, array<float> x, int off) =>
    float z = array.get(wts, off + NF)
    for k = 0 to NF - 1
        z += array.get(wts, off + k) * array.get(x, k)
    z

int row_now = bar_index % (H + 1)
int row_old = (bar_index + 1) % (H + 1)             // the sample taken H bars ago

bool health_on = conf_n >= health_warm
bool health_low = health_on and health < 0.5

// --- STEP 1: learn from the sample that just got its outcome ------------------
if barstate.isconfirmed and bar_index > H + 1 and bar_of_day >= H and not na(a[H])
    if matrix.get(hist, row_old, NF) == 1.0
        float ref = close[H]
        float atr_old = a[H]
        float up_b = ref + label_k * atr_old
        float dn_b = ref - label_k * atr_old

        // Triple-barrier label (soft target on timeout)
        float y = na
        for j = H - 1 to 0
            bool hu = high[j] >= up_b
            bool hl = low[j] <= dn_b
            if hu and hl
                y := 0.5
                break
            else if hu
                y := 1.0
                break
            else if hl
                y := 0.0
                break
        if na(y)
            y := 0.5 + 0.5 * math.max(-1.0, math.min(1.0, (close - ref) / (label_k * atr_old)))

        array<float> x_old = matrix.row(hist, row_old)
        int r_old = int(matrix.get(hist, row_old, NF + 1))
        float p_old = matrix.get(hist, row_old, NF + 2)
        int off = r_old * (NF + 1)

        // SGD step with forgetting (weight decay toward 0)
        float err = f_sig(f_logit(w, x_old, off)) - y
        float lr_eff = health_low ? lr * 2.0 : lr
        for k = 0 to NF - 1
            array.set(w, off + k, array.get(w, off + k) * decay - lr_eff * err * array.get(x_old, k))
        array.set(w, off + NF, array.get(w, off + NF) * decay - lr_eff * err)
        array.set(n_s, r_old, array.get(n_s, r_old) + 1)

        // Shadow scoring of the prediction that was live back then (true out-of-sample)
        bool was_called = math.abs(p_old - 0.5) > 1e-9
        bool decisive = y > 0.55 or y < 0.45
        if was_called and decisive
            float hit = (p_old > 0.5) == (y > 0.5) ? 1.0 : 0.0
            int b = math.min(3, int(math.abs(p_old - 0.5) / 0.03))
            array.set(cal_hit, b, array.get(cal_hit, b) + 0.02 * (hit - array.get(cal_hit, b)))
            array.set(cal_n, b, array.get(cal_n, b) + 1)
            if math.abs(p_old - 0.5) >= matrix.get(hist, row_old, NF + 3) - 0.5
                health := health + (2.0 / (health_len + 1)) * (hit - health)
                conf_n += 1

// --- STEP 2: predict with the freshly-updated weights --------------------------
array<float> x_now = array.from(z1, z2, z3, z4, z5, z6, z7, z8, z9)
bool model_ready = feat_ok and array.get(n_s, reg) >= min_samples
float p = 0.5
if model_ready
    p := f_sig(f_logit(w, x_now, reg * (NF + 1)))

float conf = math.max(p, 1.0 - p)
float conf_adapt = ta.percentile_nearest_rank(conf, 390, conf_pctile)
float eff_thr = math.max(conf_floor, nz(conf_adapt, 1.0))

// Store this bar's snapshot for later labeling
array<float> snap = array.from(z1, z2, z3, z4, z5, z6, z7, z8, z9, feat_ok ? 1.0 : 0.0, float(reg), p, eff_thr)
for c = 0 to NC - 1
    matrix.set(hist, row_now, c, array.get(snap, c))

// --- Gates ---------------------------------------------------------------------
vol_ok = not na(vol_ratio) and vol_ratio <= vol_hi and vol_ratio >= vol_lo
health_ok = not health_on or health >= health_min
trade_ok = model_ready and vol_ok and health_ok

bool call_up = model_ready and p >= eff_thr
bool call_dn = model_ready and p <= 1.0 - eff_thr
bool can_enter = strategy.position_size == 0 and in_entry and trade_ok
bool sig_long = can_enter and call_up
bool sig_short = can_enter and call_dn

// --- Orders (entry fills at NEXT bar open; bracket is ATR-scaled) ---------------
int tp_ticks = math.max(1, math.round(tp_mult * a_ok / syminfo.mintick))
int sl_ticks = math.max(1, math.round(sl_mult * a_ok / syminfo.mintick))

if sig_long
    strategy.entry("Long", strategy.long, comment="BUY " + str.tostring(conf * 100.0, "#") + "%")
    strategy.exit("Long X", "Long", profit=tp_ticks, loss=sl_ticks, comment_profit="TP", comment_loss="SL")
if sig_short
    strategy.entry("Short", strategy.short, comment="SELL " + str.tostring(conf * 100.0, "#") + "%")
    strategy.exit("Short X", "Short", profit=tp_ticks, loss=sl_ticks, comment_profit="TP", comment_loss="SL")

// Time exit: close issued at close of bar (H-1) after fill => exits at open, H bars held
if strategy.position_size != 0
    int held = bar_index - strategy.opentrades.entry_bar_index(0)
    if held >= H - 1
        strategy.close_all(comment="Time exit")
    if is_flatten
        strategy.close_all(comment="EOD flatten")

// --- Visuals -------------------------------------------------------------------
plot(ema21, "EMA 21", color=color.new(#fb923c, 30))
plotshape(sig_long, "Long Signal", shape.triangleup, location.belowbar, color.new(#22c55e, 0), size=size.small, text="UP")
plotshape(sig_short, "Short Signal", shape.triangledown, location.abovebar, color.new(#ef4444, 0), size=size.small, text="DN")
// Paused / shadow signals (model confident but a gate blocks trading)
plotchar(call_up and not trade_ok and strategy.position_size == 0, "Shadow Up", "·", location.belowbar, color.new(#22c55e, 60), size=size.tiny)
plotchar(call_dn and not trade_ok and strategy.position_size == 0, "Shadow Down", "·", location.abovebar, color.new(#ef4444, 60), size=size.tiny)
bgcolor(strategy.position_size > 0 ? color.new(#22c55e, 94) : strategy.position_size < 0 ? color.new(#ef4444, 94) : na)

// --- HUD -----------------------------------------------------------------------
var table hud = table.new(position.top_right, 2, 12, bgcolor=color.new(#0f172a, 15), border_color=color.new(#334155, 0), border_width=1)
f_cell(int r, string k, string v, color c) =>
    table.cell(hud, 0, r, k, text_color=color.new(#94a3b8, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(hud, 1, r, v, text_color=c, text_size=size.small, text_halign=text.align_right)

if show_hud and barstate.islast
    int cb = math.min(3, int(math.abs(p - 0.5) / 0.03))
    string dir_s = not model_ready ? "Warming up" : call_up ? "UP " + str.tostring(conf * 100.0, "#") + "%" : call_dn ? "DOWN " + str.tostring(conf * 100.0, "#") + "%" : "No signal (" + str.tostring(conf * 100.0, "#") + "%)"
    color dir_c = not model_ready ? color.gray : call_up ? color.green : call_dn ? color.red : color.white
    string state_s = not model_ready ? "Learning" : not vol_ok ? "Paused: volatility" : not health_ok ? "Paused: model health" : "Active"
    float wr = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : 0.0
    float pf = math.abs(strategy.grossloss) > 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : 0.0

    table.cell(hud, 0, 0, "SPX Adaptive AI", bgcolor=color.new(#1e293b, 0), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "H=" + str.tostring(H) + " bars", bgcolor=color.new(#1e293b, 0), text_color=color.new(#38bdf8, 0), text_size=size.small)
    f_cell(1, "Signal", dir_s, dir_c)
    f_cell(2, "Regime", reg == 1 ? "Trending" : "Choppy", color.white)
    f_cell(3, "Samples (chop/trend)", str.tostring(array.get(n_s, 0)) + " / " + str.tostring(array.get(n_s, 1)), color.white)
    f_cell(4, "Realised hit-rate, this conf.", array.get(cal_n, cb) > 20 ? str.tostring(array.get(cal_hit, cb) * 100.0, "#.#") + "%" : "n/a", color.white)
    f_cell(5, "Model health", health_on ? str.tostring(health * 100.0, "#.#") + "%" : "n/a", health_ok ? color.green : color.red)
    f_cell(6, "Vol state", na(vol_ratio) ? "n/a" : str.tostring(vol_ratio, "#.##") + "x", vol_ok ? color.white : color.orange)
    f_cell(7, "Status", state_s, state_s == "Active" ? color.green : color.orange)
    f_cell(8, "Net P&L", str.tostring(strategy.netprofit, "$#,###.##"), strategy.netprofit >= 0 ? color.green : color.red)
    f_cell(9, "Win rate", str.tostring(wr, "#.#") + "% (" + str.tostring(strategy.closedtrades) + ")", color.white)
    f_cell(10, "Profit factor", str.tostring(pf, "#.##"), pf >= 1.2 ? color.green : color.white)
    f_cell(11, "Session tz / in window", tz + " / " + (in_entry ? "yes" : "no"), in_entry ? color.white : color.orange)
