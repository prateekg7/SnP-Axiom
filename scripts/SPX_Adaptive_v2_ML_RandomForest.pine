    acc += (x20 <= 0.49705075 ? (x12 <= 0.00072180927 ? (x29 <= 1.6528577 ? (x7 <= 0.00054933828 ? (x7 <= 0.00054602403 ? 0.9280806 : 0.7164179) : (x3 <= 0.0033841216 ? 0.9426717 : 0.7790698)) : (x20 <= 0.37078756 ? (x25 <= 2.3479086e-05 ? 0.7142857 : 0.9087744) : (x35 <= 0.0022501346 ? 0.9947368 : 0.921875))) : 0.826087) : (x19 <= 0.00074146389 ? (x34 <= 0.50000001 ? (x6 <= 0.00081093387 ? (x20 <= 1.1719834 ? 0.9513956 : 0.8472222) : (x29 <= 1.8179985 ? 0.9066667 : 0.8076923)) : (x3 <= 0.0013781708 ? (x21 <= 0.12583322 ? 0.8045977 : 0.930192) : 0.8045977)) : (x25 <= 0.022817439 ? (x30 <= 0.9551282 ? (x12 <= 0.00068818915 ? 0.9691798 : 0.9563126) : (x26 <= 0.0022358551 ? 0.9590909 : 0.7820513)) : (x17 <= 0.0028684052 ? 0.8026316 : (x21 <= 3.688892 ? 1 : 0.9)))))
    acc += (x3 <= 0.00068897954 ? (x4 <= 0.00058971333 ? (x14 <= 0.0012302385 ? (x34 <= 0.50000001 ? (x29 <= 0.66295204 ? 0.9499272 : 0.9340906) : (x28 <= 0.0067810709 ? 0.916724 : 0.6944444)) : (x14 <= 0.0015481244 ? 0.6989247 : (x11 <= -0.00047616469 ? 0.9310345 : 0.9861111))) : (x9 <= 0.056394773 ? (x2 <= -0.0015483194 ? (x18 <= 0.00021112035 ? 0.8988764 : 0.7096774) : (x9 <= 0.036558034 ? 0.9503194 : 0.8836478)) : (x29 <= 0.53640887 ? (x20 <= 0.83956483 ? 0.9446903 : 0.8082192) : (x18 <= -0.00013976063 ? 0.9263456 : 0.9623244)))) : (x28 <= 0.0013271132 ? (x11 <= 0.00066456407 ? (x24 <= 0.00018965049 ? 1 : 0.8888889) : 0.7894737) : (x34 <= 0.50000001 ? (x19 <= 0.0034879746 ? (x25 <= 0.0021867767 ? 0.9412686 : 0.9626803) : (x22 <= 0.0035166191 ? 0.9541985 : 0.8434783)) : (x8 <= 0.85244786 ? (x29 <= 1.6046871 ? 0.9284254 : 1) : (x13 <= 0.0015991452 ? 0.7875 : 0.9333333)))))
    acc

f_tu_3(array<float> x) =>
    float x0 = array.get(x, 0)
    float x1 = array.get(x, 1)
    float x2 = array.get(x, 2)
    float x3 = array.get(x, 3)
    float x4 = array.get(x, 4)
    float x5 = array.get(x, 5)
    float x6 = array.get(x, 6)
    float x7 = array.get(x, 7)
    float x8 = array.get(x, 8)
    float x9 = array.get(x, 9)
    float x10 = array.get(x, 10)
    float x11 = array.get(x, 11)
    float x12 = array.get(x, 12)
    float x13 = array.get(x, 13)
    float x14 = array.get(x, 14)
    float x15 = array.get(x, 15)
    float x16 = array.get(x, 16)
    float x17 = array.get(x, 17)
    float x18 = array.get(x, 18)
    float x19 = array.get(x, 19)
    float x20 = array.get(x, 20)
    float x21 = array.get(x, 21)
    float x22 = array.get(x, 22)
    float x23 = array.get(x, 23)
    float x25 = array.get(x, 25)
    float x26 = array.get(x, 26)
    float x27 = array.get(x, 27)
    float x28 = array.get(x, 28)
    float x29 = array.get(x, 29)
    float x30 = array.get(x, 30)
    float x31 = array.get(x, 31)
    float x34 = array.get(x, 34)
    float x35 = array.get(x, 35)
    float acc = 0.0
    acc += (x18 <= 2.1523852e-05 ? (x34 <= 0.50000001 ? (x2 <= 0.0010874412 ? (x6 <= 0.00093483419 ? (x27 <= 0.0147283 ? 0.9395349 : 0.8125) : (x9 <= 0.19558104 ? 0.8733553 : 0.9562044)) : (x10 <= 0.00036900791 ? (x16 <= 4.6965448e-05 ? 0.8688525 : 0.9677419) : (x29 <= 1.6634484 ? 0.9734577 : 0.9210526))) : (x28 <= 0.0072730133 ? (x30 <= 0.9551282 ? (x13 <= 0.0027331184 ? 0.9493088 : 0.8235294) : (x7 <= 0.0016747575 ? 0.8808194 : 0.9651163)) : 0.7936508)) : (x30 <= 0.89102565 ? (x17 <= -0.0012370697 ? (x14 <= -0.00019552706 ? (x13 <= -0.0018254734 ? 0.9532308 : 0.84375) : 0.8411215) : (x28 <= 0.017797074 ? (x25 <= 0.022537916 ? 0.9613682 : 0.8035714) : 0.8623853)) : (x25 <= 0.001799583 ? (x17 <= -0.00060134286 ? (x11 <= -0.00022143845 ? 0.9710145 : 0.9056604) : (x17 <= -0.00015886606 ? 0.9923077 : 0.9565217)) : (x12 <= 7.4991563e-06 ? (x18 <= 0.00014696387 ? 0.9175258 : 0.6944444) : (x26 <= 0.00086992243 ? 0.885906 : 0.9432799)))))
    acc += (x22 <= 0.00060290856 ? (x25 <= 0.0048665906 ? (x34 <= 0.50000001 ? (x8 <= 0.017366174 ? 0.8403361 : (x16 <= -4.2625263e-05 ? 0.9688581 : 0.944269)) : (x16 <= 0.00050090236 ? (x28 <= 0.0030033728 ? 0.9288703 : 0.7704918) : 0.7866667)) : (x27 <= 0.0011810908 ? (x2 <= 1.2165846e-06 ? 0.8571429 : (x28 <= 0.0014975384 ? 0.8266667 : 0.9607438)) : (x17 <= -0.0019857863 ? 0.8615385 : (x2 <= -0.00025486466 ? 0.8780488 : 0.969915)))) : (x20 <= 0.36369104 ? (x19 <= 0.000413599 ? (x19 <= 0.00040257833 ? (x27 <= 0.00074096715 ? 0.915493 : 0.8311688) : 0.6923077) : (x26 <= 0.014730813 ? (x14 <= -0.004860191 ? 0.8301887 : 0.9360984) : 0.8181818)) : (x11 <= -0.0012484565 ? (x15 <= 0.47326777 ? 0.9552239 : 0.8108108) : (x17 <= 0.00095261537 ? (x28 <= 0.012996372 ? 0.9531787 : 0.8964143) : (x17 <= 0.0010364459 ? 0.8694158 : 0.9410511)))))
    acc += (x11 <= 0.00025656457 ? (x30 <= 0.26282051 ? (x7 <= 0.0016651927 ? (x27 <= 0.0065073406 ? (x9 <= 0.67292589 ? 0.9678995 : 0.9344262) : (x2 <= -0.0013773098 ? 0.9659091 : 0.8882979)) : (x3 <= -0.0074117182 ? (x21 <= 1.4691074 ? 0.7619048 : 0.8938053) : (x5 <= 0.0057562296 ? 0.9485981 : 0.8194444))) : (x31 <= 0.76942085 ? (x2 <= -0.0020851161 ? (x28 <= 0.0027396847 ? 0.75 : 0.8976744) : (x20 <= -0.098321595 ? 0.8787879 : 0.9317869)) : (x29 <= 0.5874274 ? (x22 <= 0.00076602804 ? 0.9411765 : 0.9909091) : (x6 <= 0.00013455662 ? 0.9557352 : 0.9130435)))) : (x17 <= -0.0019816205 ? (x4 <= 0.0054213397 ? (x19 <= 0.0018946397 ? (x28 <= 0.0054936354 ? 0.9552239 : 1) : (x26 <= 0.0041260598 ? 0.7974684 : 0.972973)) : 0.7746479) : (x1 <= -0.00020519882 ? (x29 <= 0.50466636 ? 0.8598131 : (x8 <= 0.069170159 ? 0.8947368 : 0.9494681)) : (x7 <= 0.0015656401 ? (x30 <= 0.76282052 ? 0.967061 : 0.9439746) : (x11 <= 0.00088100467 ? 0.8911175 : 0.9547199)))))
    acc += (x20 <= 0.65530776 ? (x20 <= -0.12588129 ? (x7 <= 0.00075825865 ? 0.7391304 : (x10 <= 0.0024782231 ? 0.7241379 : (x22 <= 0.002975522 ? 0.9821429 : 0.8813906))) : (x23 <= 0.0055838034 ? (x13 <= 0.004246982 ? (x23 <= 0.0034551765 ? 0.9387587 : 0.9754959) : (x10 <= 0.25416953 ? 0.9393939 : 0.8139535)) : (x22 <= 0.0011629494 ? 0.7333333 : (x12 <= -0.0027136605 ? 0.7804878 : 0.9517544)))) : (x4 <= 0.020665346 ? (x34 <= 0.50000001 ? (x35 <= -0.0087270136 ? (x25 <= 0.0044765109 ? 0.984375 : 0.8) : (x18 <= 2.2219103e-05 ? 0.941946 : 0.9637811)) : (x21 <= 0.20372538 ? (x28 <= 0.0015445337 ? 0.9306931 : 0.7969925) : (x23 <= 0.0039414449 ? 0.9565943 : 0.8806818))) : 0.8461538))
    acc += (x30 <= 0.9551282 ? (x22 <= 0.018729702 ? (x3 <= 0.00065768123 ? (x20 <= -0.12588129 ? (x1 <= -0.0010543102 ? 0.9061033 : 0.7875) : (x30 <= 0.12179487 ? 0.9651076 : 0.9413063)) : (x28 <= 0.0012884355 ? (x16 <= 0.00051590855 ? 0.9633028 : 0.8023256) : (x17 <= -0.0028040146 ? 0.9119171 : 0.960318))) : (x12 <= -0.012151589 ? 0.7068966 : 0.8428571)) : (x0 <= -0.0010287814 ? 0.7113402 : (x26 <= 0.0015461876 ? (x0 <= 0.00050312738 ? (x9 <= 0.22118448 ? 0.9694323 : 0.8713826) : (x0 <= 0.00071569544 ? 1 : 0.9655172)) : (x23 <= 0.0041988536 ? (x26 <= 0.0017236553 ? 0.6538462 : 0.8454936) : 0.969697))))
    acc

f_eval_tu(array<float> x) =>
    (f_tu_0(x) + f_tu_1(x) + f_tu_2(x) + f_tu_3(x)) / 20.0

// ─── Session State & Daily Levels ────────────────────────────────────────────
inEntry   = not na(time(timeframe.period, entrySession, tz))
inFlat    = not na(time(timeframe.period, flatSession, tz))
inOpening = not na(time(timeframe.period, openingSession, tz))

var float openingHigh  = na
var float openingLow   = na
var bool  openingReady = false
var float sessHlc3Sum  = 0.0
var int   sessBarCnt   = 0
var float sessionOpen  = na

if ta.change(time("D", tz)) != 0
    openingHigh  := na
    openingLow   := na
    openingReady := false
    sessionOpen  := open
    sessHlc3Sum  := hlc3
    sessBarCnt   := 1
else
    sessHlc3Sum  += hlc3
    sessBarCnt   += 1

if inOpening
    openingHigh := na(openingHigh) ? high : math.max(openingHigh, high)
    openingLow  := na(openingLow) ? low : math.min(openingLow, low)
if not inOpening and not na(openingHigh) and not na(openingLow)
    openingReady := true

// ─── Continuous Series (Global Scope) ────────────────────────────────────────
float lr1 = close[1] > 0 ? math.log(close / close[1]) : 0.0
[macdLine, macdSig, macdDiff] = ta.macd(close, 12, 26, 9)
[bbMid, bbUp, bbLo] = ta.bb(close, 20, 2.0)
float rh12 = ta.highest(high, 12)
float rl12 = ta.lowest(low, 12)
float rh36 = ta.highest(high, 36)
float rl36 = ta.lowest(low, 36)
float rv6  = nz(ta.stdev(lr1, 6)) * math.sqrt(6.0)
float rv12 = nz(ta.stdev(lr1, 12)) * math.sqrt(12.0)
float rv24 = nz(ta.stdev(lr1, 24)) * math.sqrt(24.0)
float avgR12 = ta.sma(high - low, 12)

emaFast = ta.ema(close, 9)
emaMid  = ta.ema(close, 21)
emaSlow = ta.ema(close, 50)
rsiRaw  = ta.rsi(close, 14)
atr     = ta.atr(14)
atrSlow = ta.sma(atr, slowAtrLen)
volRatio = atrSlow > 0 ? atr / atrSlow : na
[diPlus, diMinus, adx] = ta.dmi(14, 14)

rawVwap   = ta.vwap(hlc3)
twapValue = sessBarCnt > 0 ? sessHlc3Sum / sessBarCnt : hlc3
vwapValue = not na(rawVwap) ? rawVwap : twapValue

c2  = close[2]
c3  = close[3]
c6  = close[6]
c12 = close[12]
c24 = close[24]

priorDayHigh = request.security(syminfo.tickerid, "D", high[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
priorDayLow  = request.security(syminfo.tickerid, "D", low[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

volOk = not na(volRatio) and volRatio >= minVolRatio and volRatio <= maxVolRatio
ready = not na(atrSlow) and atrSlow > 0 and not na(vwapValue) and not na(adx)
bool canEnter = strategy.position_size == 0 and ready and volOk and inEntry and barstate.isconfirmed

// ─── Exact 36 Features Function ──────────────────────────────────────────────
f_fill_raw_features(array<float> x) =>
    float barRange = high - low
    float bbSpan = bbUp - bbLo
    float f15_rsi_14 = nz(rsiRaw, 50.0) / 100.0
    float f20_bb_pband = bbSpan > 0 ? (close - bbLo) / bbSpan : 0.5
    int minOfDay = hour(time, tz) * 60 + minute(time, tz)
    float sessMin = math.min(390.0, math.max(0.0, minOfDay - 570.0))
    int dowPy = math.min(4, math.max(0, dayofweek(time, tz) - 2))

    array.set(x, 0,  nz(lr1))
    array.set(x, 1,  c2 > 0 ? math.log(close / c2) : 0.0)
    array.set(x, 2,  c3 > 0 ? math.log(close / c3) : 0.0)
    array.set(x, 3,  c6 > 0 ? math.log(close / c6) : 0.0)
    array.set(x, 4,  c12 > 0 ? math.log(close / c12) : 0.0)
    array.set(x, 5,  c24 > 0 ? math.log(close / c24) : 0.0)
    array.set(x, 6,  open > 0 ? math.log(close / open) : 0.0)
    array.set(x, 7,  close > 0 ? barRange / close : 0.0)
    array.set(x, 8,  barRange > 0 ? math.abs(close - open) / barRange : 0.0)
    array.set(x, 9,  barRange > 0 ? (high - math.max(open, close)) / barRange : 0.0)
    array.set(x, 10, barRange > 0 ? (math.min(open, close) - low) / barRange : 0.0)
    array.set(x, 11, close > 0 ? (close - emaFast) / close : 0.0)
    array.set(x, 12, close > 0 ? (close - emaMid) / close : 0.0)
    array.set(x, 13, close > 0 ? (close - emaSlow) / close : 0.0)
    array.set(x, 14, close > 0 ? (emaFast - emaMid) / close : 0.0)
    array.set(x, 15, f15_rsi_14)
    array.set(x, 16, close > 0 ? nz(macdLine) / close : 0.0)
    array.set(x, 17, close > 0 ? nz(macdSig) / close : 0.0)
    array.set(x, 18, close > 0 ? nz(macdDiff) / close : 0.0)
    array.set(x, 19, close > 0 ? nz(atr) / close : 0.0)
    array.set(x, 20, nz(f20_bb_pband, 0.5))
    array.set(x, 21, bbMid > 0 ? (bbSpan / bbMid) * 100.0 : 0.0)
    array.set(x, 22, close > 0 ? (rh12 - close) / close : 0.0)
    array.set(x, 23, close > 0 ? (close - rl12) / close : 0.0)
    array.set(x, 24, close > 0 ? (rh36 - close) / close : 0.0)
    array.set(x, 25, close > 0 ? (close - rl36) / close : 0.0)
    array.set(x, 26, nz(rv6))
    array.set(x, 27, nz(rv12))
    array.set(x, 28, nz(rv24))
    array.set(x, 29, avgR12 > 0 ? barRange / avgR12 : 1.0)
    array.set(x, 30, sessMin / 390.0)
    array.set(x, 31, math.sin(2.0 * math.pi * dowPy / 5.0))
    array.set(x, 32, math.cos(2.0 * math.pi * dowPy / 5.0))
    array.set(x, 33, sessMin <= 30.0 ? 1.0 : 0.0)
    array.set(x, 34, sessMin >= 360.0 ? 1.0 : 0.0)
    array.set(x, 35, sessionOpen > 0 ? math.log(close / sessionOpen) : 0.0)

// ─── Adaptive v2 Core ────────────────────────────────────────────────────────
f_calc_v2() =>
    bool tRegime = adx >= trendAdx and emaMid != 0 and math.abs(emaMid - emaSlow) / emaMid > 0.00015
    float ret3  = c3 > 0 ? close / c3 - 1.0 : 0.0
    float ret6  = c6 > 0 ? close / c6 - 1.0 : 0.0
    float ret12 = c12 > 0 ? close / c12 - 1.0 : 0.0
    float vwapDistAtr = atr > 0 and not na(vwapValue) ? (close - vwapValue) / atr : 0.0

    float tScore = 0.0
    tScore += emaFast > emaMid ? 0.40 : -0.40
    tScore += emaMid > emaSlow ? 0.70 : -0.70
    tScore += ret3 > 0 ? 0.30 : -0.30
    tScore += ret6 > 0 ? 0.25 : -0.25
    tScore += ret12 > 0 ? 0.65 : -0.65
    tScore += diPlus > diMinus ? 0.35 : -0.35
    tScore += useVwapFilter ? (close > vwapValue ? 0.45 : -0.45) : 0.0
    if useOpeningRange and openingReady
        tScore += close > openingHigh ? 0.75 : (close < openingLow ? -0.75 : 0.0)
    tScore += close > priorDayHigh ? 0.30 : (close < priorDayLow ? -0.30 : 0.0)

    float rScore = 0.0
    if vwapDistAtr < -0.90
        rScore += 0.60
    else if vwapDistAtr > 0.90
        rScore -= 0.60
    if rsiRaw < 32.0
        rScore += 1.10
    else if rsiRaw > 68.0
        rScore -= 1.10
    rScore += close > emaFast ? 0.20 : -0.20
    rScore += diPlus > diMinus ? 0.15 : -0.15

    float rawScore = tRegime ? tScore : rScore
    float conf     = 1.0 / (1.0 + math.exp(-math.min(8.0, math.max(-8.0, math.abs(rawScore) * 0.65))))
    bool  v2L      = rawScore >= 2.20 and conf >= 0.65
    bool  v2S      = rawScore <= -2.20 and conf >= 0.65
    float v2N      = math.min(1.0, math.max(-1.0, rawScore / 3.50))
    [tRegime, rawScore, v2L, v2S, v2N]

// ─── Execution & Signal Generation ───────────────────────────────────────────
var array<float> xRaw = array.new_float(36, 0.0)
bool  trendRegime = false
float mlR1        = na
float pCloseUp    = na
float calPTouch   = na
float mlScore     = na
float v2RawScore  = na
float hybridScore = na
bool  enterLong   = false
bool  enterShort  = false

if canEnter or barstate.islast
    f_fill_raw_features(xRaw)
    mlR1        := f_eval_r1(xRaw)
    pCloseUp    := math.min(1.0, math.max(0.0, f_eval_cu(xRaw)))
    float mlPath30 = f_eval_p30(xRaw)
    float rawTouch = math.min(0.9999, math.max(0.0001, f_eval_tu(xRaw)))
    calPTouch   := f_platt(rawTouch)

    mlScore     := 0.50 * (pCloseUp - 0.50) * 4.0 + 0.30 * math.min(2.0, math.max(-2.0, mlR1 * 2500.0)) + 0.20 * math.min(2.0, math.max(-2.0, mlPath30 * 1000.0))

    [tReg, v2S_raw, v2L, v2S, v2N] = f_calc_v2()
    trendRegime := tReg
    v2RawScore  := v2S_raw
    hybridScore := mlWeight * mlScore + adaptiveWeight * v2N

    if canEnter
        enterLong  := hybridScore >= fusionThr and mlScore >= minMlConfirm
        enterShort := hybridScore <= -fusionThr and mlScore <= -minMlConfirm

// ─── Orders & Rock-Solid Bracket Management ──────────────────────────────────
int tpTicks = math.max(1, int(math.round(tpAtr * atr / syminfo.mintick)))
int slTicks = math.max(1, int(math.round(slAtr * atr / syminfo.mintick)))

if enterLong
    strategy.entry("RF_Long", strategy.long, comment="RF LONG " + str.tostring(hybridScore, "#.##"))
    strategy.exit("Exit_RF_Long", "RF_Long", profit=tpTicks, loss=slTicks)
if enterShort
    strategy.entry("RF_Short", strategy.short, comment="RF SHORT " + str.tostring(hybridScore, "#.##"))
    strategy.exit("Exit_RF_Short", "RF_Short", profit=tpTicks, loss=slTicks)

if strategy.position_size != 0
    int heldBars = bar_index - strategy.opentrades.entry_bar_index(0)
    if heldBars >= maxHoldBars
        strategy.close_all(comment="Max hold")
    if inFlat
        strategy.close_all(comment="Session flatten")

// ─── Visuals & HUD ───────────────────────────────────────────────────────────
plot(emaMid, "EMA 21", color=color.new(color.orange, 25))
plot(vwapValue, "Session VWAP", color=color.new(color.aqua, 10), linewidth=2)
plotshape(showSignals and enterLong, title="RF Long", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="RF+")
plotshape(showSignals and enterShort, title="RF Short", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="RF-")
bgcolor(strategy.position_size > 0 ? color.new(color.green, 93) : strategy.position_size < 0 ? color.new(color.red, 93) : na)

var table hud = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 15), border_color=color.new(color.gray, 65), border_width=1)
if showHud and barstate.islast
    float wr = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : na
    float pf = strategy.grossloss < 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na
    table.cell(hud, 0, 0, "SPX v2 + Random Forest", text_color=color.white, bgcolor=color.new(color.blue, 65))
    table.cell(hud, 1, 0, "110 Trees", text_color=color.yellow, bgcolor=color.new(color.blue, 65))
    table.cell(hud, 0, 1, "Regime", text_color=color.silver)
    table.cell(hud, 1, 1, trendRegime ? "TREND" : "RANGE", text_color=trendRegime ? color.aqua : color.orange)
    table.cell(hud, 0, 2, "Hybrid Score", text_color=color.silver)
    table.cell(hud, 1, 2, str.tostring(hybridScore, "#.###"), text_color=hybridScore >= 0.32 ? color.lime : (hybridScore <= -0.32 ? color.red : color.silver))
    table.cell(hud, 0, 3, "ML Score", text_color=color.silver)
    table.cell(hud, 1, 3, str.tostring(mlScore, "#.###"), text_color=color.aqua)
    table.cell(hud, 0, 4, "P(Close UP)", text_color=color.silver)
    table.cell(hud, 1, 4, str.tostring(pCloseUp * 100.0, "#.#") + "%", text_color=color.white)
    table.cell(hud, 0, 5, "Trades (Win Rate)", text_color=color.silver)
    table.cell(hud, 1, 5, str.tostring(strategy.closedtrades) + " (" + str.tostring(wr, "#.#") + "%)", text_color=color.white)
    table.cell(hud, 0, 6, "Net PnL", text_color=color.silver)
    table.cell(hud, 1, 6, str.tostring(strategy.netprofit, "#.##"), text_color=strategy.netprofit >= 0 ? color.lime : color.red)
