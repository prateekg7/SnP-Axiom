//@version=6
strategy(
     title="SPX Adaptive v2 + Trained Random Forest ML [Native Pine]",
     shorttitle="SPX v2+RF",
     overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     commission_type=strategy.commission.cash_per_order,
     commission_value=0.15,
     slippage=1,
     pyramiding=0,
     calc_on_every_tick=false,
     process_orders_on_close=false,
     max_bars_back=500)

// =============================================================================
// NATIVE TRADINGVIEW RANDOM FOREST ENSEMBLE + ADAPTIVE v2 STRATEGY
// -----------------------------------------------------------------------------
// Trained directly on canonical SnP-Axiom features & targets:
//   - RandomForestRegressor (`r_1`: 35 trees, `r_path_30m`: 25 trees)
//   - RandomForestClassifier (`y_close_up`: 30 trees, `y_touch_up`: 20 trees)
//   - ProbabilityCalibrator (Platt coef=0.49456004, intercept=1.45110506)
//   - Exact 36 FeaturePipeline inputs with StandardScaler folded into split thresholds
//   - Gated execution (`if canEnter or barstate.islast`) + zero external dependencies
// =============================================================================

// ─── Inputs ──────────────────────────────────────────────────────────────────
grpSess = "Session"
tz              = input.string("America/New_York", "Session timezone", group=grpSess)
entrySession    = input.session("0935-1550:23456", "Entry window", group=grpSess)
flatSession     = input.session("1555-1600:23456", "Flatten window", group=grpSess)
openingSession  = input.session("0930-1000:23456", "Opening range window", group=grpSess)
useVwapFilter   = input.bool(true, "Use session VWAP", group=grpSess)

grpHybrid = "Hybrid Fusion (Adaptive v2 + Random Forest)"
mlWeight        = input.float(0.55, "ML weight", minval=0.0, maxval=1.0, step=0.05, group=grpHybrid)
adaptiveWeight  = input.float(0.45, "Adaptive v2 weight", minval=0.0, maxval=1.0, step=0.05, group=grpHybrid)
fusionThr       = input.float(0.32, "Hybrid entry threshold", minval=0.05, maxval=1.0, step=0.02, group=grpHybrid)
minMlConfirm    = input.float(0.04, "Minimum ML score confirmation", minval=0.0, maxval=0.5, step=0.01, group=grpHybrid)
trendAdx        = input.float(20.0, "Trend regime ADX", minval=5.0, step=0.5, group=grpHybrid)
useOpeningRange = input.bool(true, "Use opening-range breakout", group=grpHybrid)

grpRisk = "Risk Management"
tpAtr           = input.float(2.00, "Take profit (ATR)", minval=0.25, step=0.05, group=grpRisk)
slAtr           = input.float(1.00, "Stop loss (ATR)", minval=0.25, step=0.05, group=grpRisk)
maxHoldBars     = input.int(6, "Maximum holding bars", minval=1, maxval=24, group=grpRisk)
maxVolRatio     = input.float(2.50, "Skip if ATR / slow ATR exceeds", minval=1.1, step=0.1, group=grpRisk)
minVolRatio     = input.float(0.45, "Skip if ATR / slow ATR below", minval=0.1, maxval=1.0, step=0.05, group=grpRisk)
slowAtrLen      = input.int(156, "Slow ATR baseline bars", minval=30, group=grpRisk)

grpDisp = "Display"
showHud         = input.bool(true, "Show hybrid HUD", group=grpDisp)
showSignals     = input.bool(true, "Show entry markers", group=grpDisp)

// ─── Math & Functions ────────────────────────────────────────────────────────
f_sigmoid(float z) =>
    1.0 / (1.0 + math.exp(-math.min(20.0, math.max(-20.0, z))))

f_platt(float rawP) =>
    float p = math.min(1.0 - 1e-6, math.max(1e-6, rawP))
    float logOdds = math.log(p / (1.0 - p))
    f_sigmoid(0.49456004 * logOdds + (1.45110506))

f_tanh(float x) =>
    float e2 = math.exp(2.0 * math.min(10.0, math.max(-10.0, x)))
    (e2 - 1.0) / (e2 + 1.0)

