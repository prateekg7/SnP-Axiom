//@version=5
strategy(
     title="SPX Coupled AI + Bracket Strategy [SnP-Axiom]",
     shorttitle="SPX AI Bracket",
     overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     commission_type=strategy.commission.cash_per_order,
     commission_value=0.15,
     slippage=0,
     process_orders_on_close=true
     )

// =============================================================================
// SPX COUPLED AI + ASYMMETRIC BRACKET STRATEGY
// =============================================================================
// Implementation of the validated 5-minute S&P 500 (SPX) cash index strategy.
// Features:
//   1. AI Drift & Touch Probability Model: Combines multi-horizon return drift,
//      MACD histogram momentum, and Black-Scholes analytical barrier probability.
//   2. Technical Oscillator Coupling: Employs RSI(14) and Bollinger %B filters
//      to prevent buying overbought tops or shorting oversold bottoms in
//      mean-reverting regimes.
//   3. 2:1 Asymmetric Bracket Execution: Fixed +3.0 pt Take-Profit and -1.5 pt
//      Stop-Loss with a strict 6-bar (30-minute) maximum holding duration.
//   4. Intraday Session Management: Restricts entries to regular hours (09:30-16:00 ET)
//      and flattens positions prior to the market close (15:55 ET).
//
// Recommended Chart Setup:
//   - Symbol: SPX (S&P 500 Index), SPY, or ES1!
//   - Timeframe: 5 Minutes (5m)
//   - Session: Regular Trading Hours (RTH 09:30 - 16:00 ET)
// =============================================================================

// --- Inputs: Bracket Order Parameters ---
grp_bracket = "Asymmetric Bracket Configuration"
tp_pts = input.float(3.0, "Take-Profit Target (SPX points)", minval=0.5, step=0.5, group=grp_bracket, tooltip="Target profit in index points (+3.0 pts)")
sl_pts = input.float(1.5, "Stop-Loss Target (SPX points)", minval=0.5, step=0.5, group=grp_bracket, tooltip="Risk stop in index points (-1.5 pts)")
max_bars_held = input.int(6, "Maximum Bars Held (30m window)", minval=1, maxval=24, group=grp_bracket, tooltip="Max bars to hold before time-based exit (6 bars = 30m on 5m chart)")
exit_on_session_close = input.bool(true, "Flatten Before EOD (15:55 ET)", group=grp_bracket, tooltip="Close any open position on or after 15:55 ET to avoid overnight gap risk")

// --- Inputs: AI Model & Quantitative Parameters ---
grp_model = "AI Drift & Barrier Touch Model"
min_return_drift = input.float(0.00008, "Minimum Return Drift (r_1 threshold)", minval=0.00001, step=0.00001, group=grp_model, tooltip="Minimum 5-minute directional expected drift magnitude")
min_touch_prob = input.float(0.90, "Minimum Touch Probability (+3.0 pt barrier)", minval=0.50, maxval=0.99, step=0.01, group=grp_model, tooltip="Black-Scholes analytical touch probability threshold")
use_bs_touch = input.bool(true, "Use Black-Scholes Barrier Reflection Filter", group=grp_model, tooltip="Computes first-passage probability of +3.0 pts under geometric Brownian motion")

// --- Inputs: Technical Oscillator Filters ---
grp_tech = "Technical Oscillator Filters (Mean Reversion)"
rsi_len = input.int(14, "RSI Length", minval=2, group=grp_tech)
rsi_ob_long_filter = input.float(58.0, "RSI Long Ceiling (Overbought Filter)", minval=40.0, maxval=80.0, group=grp_tech, tooltip="Block Long entries if RSI >= this level")
rsi_os_short_filter = input.float(42.0, "RSI Short Floor (Oversold Filter)", minval=20.0, maxval=60.0, group=grp_tech, tooltip="Block Short entries if RSI <= this level")

bb_len = input.int(20, "Bollinger Bands Length", minval=5, group=grp_tech)
bb_mult = input.float(2.0, "Bollinger Bands Multiplier", minval=0.5, step=0.1, group=grp_tech)
bb_pband_long_max = input.float(0.85, "Bollinger %B Long Max", minval=0.50, maxval=1.0, step=0.05, group=grp_tech, tooltip="Block Long if price is too close to upper band")
bb_pband_short_min = input.float(0.15, "Bollinger %B Short Min", minval=0.0, maxval=0.50, step=0.05, group=grp_tech, tooltip="Block Short if price is too close to lower band")

// --- Inputs: Session & Display ---
grp_ui = "Session & Display Settings"
rth_session = input.session("0930-1600:23456", "Trading Session (ET)", group=grp_ui)
show_emas = input.bool(true, "Display EMAs (9 / 21 / 50)", group=grp_ui)
show_bb = input.bool(true, "Display Bollinger Bands", group=grp_ui)
show_targets = input.bool(true, "Display Active Bracket Targets (TP / SL)", group=grp_ui)
show_hud = input.bool(true, "Display HUD Performance Table", group=grp_ui)

// =============================================================================
// TECHNICAL INDICATOR CALCULATIONS
// =============================================================================

// 1. Moving Averages
ema9 = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
ema50 = ta.ema(close, 50)

// 2. Relative Strength Index (RSI)
rsi_val = ta.rsi(close, rsi_len)

// 3. Bollinger Bands & Percent Bandwidth (%B)
[bb_mid, bb_upper, bb_lower] = ta.bb(close, bb_len, bb_mult)
bb_range = bb_upper - bb_lower
bb_pband = bb_range > 0 ? (close - bb_lower) / bb_range : 0.5

// 4. Moving Average Convergence Divergence (MACD)
[macd_line, macd_signal, macd_hist] = ta.macd(close, 12, 26, 9)

// 5. Multi-Horizon Log Returns
log_ret_1 = math.log(close / close[1])
log_ret_3 = math.log(close / math.max(1e-6, close[3]))
log_ret_6 = math.log(close / math.max(1e-6, close[6]))
log_ret_24 = math.log(close / math.max(1e-6, close[24]))

// 6. Rolling Realized Volatility (6 bars = 30 minutes)
vol_stdev = ta.stdev(log_ret_1, 6)
realized_vol_30m = vol_stdev * math.sqrt(6.0)

// =============================================================================
// AI DIRECTIONAL DRIFT & TOUCH PROBABILITY
// =============================================================================

// Standard Normal CDF Approximation (Abramowitz and Stegun)
f_norm_cdf(x) =>
    t = 1.0 / (1.0 + 0.2316419 * math.abs(x))
    poly = t * (0.319381530 + t * (-0.356563782 + t * (1.781477937 + t * (-1.821255978 + 1.330274429 * t))))
    approx = 1.0 - (1.0 / math.sqrt(2.0 * math.pi)) * math.exp(-0.5 * x * x) * poly
    x >= 0.0 ? approx : 1.0 - approx

// Black-Scholes First-Passage Touch Probability for +3.0 pt barrier
f_touch_prob(price, target_pts, vol_30m, drift_5m) =>
    if price <= 0.0 or vol_30m <= 0.0
        0.50
    else
        barrier = price + target_pts
        sigma_annual = math.max(1e-4, vol_30m * math.sqrt(19656.0 / 6.0))
        dt_years = 1.0 / 19656.0
        mu_annual = drift_5m * 19656.0
        h = math.log(barrier / price)
        if h <= 1e-6
            1.0
        else
            mu_adj = mu_annual - 0.5 * math.pow(sigma_annual, 2)
            vol_sqrt = sigma_annual * math.sqrt(dt_years)
            d1 = (-h + mu_adj * dt_years) / vol_sqrt
            d2 = (-h - mu_adj * dt_years) / vol_sqrt
            power_term = 2.0 * mu_adj / math.pow(sigma_annual, 2)
            ratio = math.pow(barrier / price, power_term)
            p = f_norm_cdf(d1) + ratio * f_norm_cdf(d2)
            math.min(1.0, math.max(0.0, p))

// Composite Directional Return Drift (mimicking trained LightGBM multi-factor output)
ema_dist_norm = (close - ema21) / close
macd_diff_norm = macd_hist / close
intra_bar_drift = (close - open) / open
r_1_drift = 0.35 * (log_ret_1 * 0.40 + intra_bar_drift * 0.30 + log_ret_3 * 0.30) + 0.25 * (log_ret_24 / 24.0) + 0.20 * macd_diff_norm + 0.20 * ema_dist_norm

// Analytical Touch Probability
cal_p_touch = use_bs_touch ? f_touch_prob(close, tp_pts, realized_vol_30m, r_1_drift) : 0.95

// =============================================================================
// COUPLED AI + TECHNICAL STRATEGY RULES
// =============================================================================

// Session validity (regular hours)
in_rth = not na(time(timeframe.period, rth_session, "America/New_York"))
time_ny = time(timeframe.period, "1555-1600:23456", "America/New_York")
is_eod_bar = not na(time_ny)

// Long Rule: Bullish AI drift + high touch probability + RSI not overbought (< 58) + price not piercing upper BB (< 0.85)
long_entry = (r_1_drift > min_return_drift) and (cal_p_touch >= min_touch_prob) and (rsi_val < rsi_ob_long_filter) and (bb_pband < bb_pband_long_max) and in_rth and not is_eod_bar

// Short Rule: Bearish AI drift + RSI not oversold (> 42) + price not piercing lower BB (> 0.15)
short_entry = (r_1_drift < -min_return_drift) and (rsi_val > rsi_os_short_filter) and (bb_pband > bb_pband_short_min) and in_rth and not is_eod_bar

// =============================================================================
// POSITION & BRACKET ORDER MANAGEMENT
// =============================================================================

var float entry_price = na
var int entry_bar_index = na
var float active_tp = na
var float active_sl = na
var int bars_in_trade = 0

// Track active bars held
if strategy.position_size != 0
    bars_in_trade := bars_in_trade + 1
else
    bars_in_trade := 0
    entry_price := na
    entry_bar_index := na
    active_tp := na
    active_sl := na

// 1. Long Entry Execution
if long_entry and strategy.position_size == 0
    strategy.entry("Long Entry", strategy.long, comment="BUY @ " + str.tostring(close, "#.##"))
    entry_price := close
    entry_bar_index := bar_index
    active_tp := close + tp_pts
    active_sl := close - sl_pts
    bars_in_trade := 0

// 2. Short Entry Execution
if short_entry and strategy.position_size == 0
    strategy.entry("Short Entry", strategy.short, comment="SELL @ " + str.tostring(close, "#.##"))
    entry_price := close
    entry_bar_index := bar_index
    active_tp := close - tp_pts
    active_sl := close + sl_pts
    bars_in_trade := 0

// 3. Bracket Exits for Active Long
if strategy.position_size > 0
    // Asymmetric Take-Profit and Stop-Loss orders
    strategy.exit("Long Bracket", from_entry="Long Entry", limit=active_tp, stop=active_sl, comment_profit="TP +3.0 pts", comment_loss="SL -1.5 pts")
    
    // Max 6-Bar Duration Time-Based Exit (30 minutes)
    if bars_in_trade >= max_bars_held
        strategy.close("Long Entry", comment="Max 6 Bars Exit")
    
    // EOD Flattening
    if exit_on_session_close and is_eod_bar
        strategy.close("Long Entry", comment="EOD Session Close")

// 4. Bracket Exits for Active Short
if strategy.position_size < 0
    // Asymmetric Take-Profit and Stop-Loss orders
    strategy.exit("Short Bracket", from_entry="Short Entry", limit=active_tp, stop=active_sl, comment_profit="TP +3.0 pts", comment_loss="SL -1.5 pts")
    
    // Max 6-Bar Duration Time-Based Exit (30 minutes)
    if bars_in_trade >= max_bars_held
        strategy.close("Short Entry", comment="Max 6 Bars Exit")
    
    // EOD Flattening
    if exit_on_session_close and is_eod_bar
        strategy.close("Short Entry", comment="EOD Session Close")

// =============================================================================
// CHART PLOTS & VISUAL OVERLAYS
// =============================================================================

// Moving Averages
plot(show_emas ? ema9 : na, "EMA 9", color=color.new(#38bdf8, 20), linewidth=1)
plot(show_emas ? ema21 : na, "EMA 21", color=color.new(#fb923c, 20), linewidth=1)
plot(show_emas ? ema50 : na, "EMA 50", color=color.new(#a855f7, 20), linewidth=2)

// Bollinger Bands
p_bb_mid = plot(show_bb ? bb_mid : na, "BB Basis", color=color.new(#64748b, 40), linewidth=1)
p_bb_upper = plot(show_bb ? bb_upper : na, "BB Upper", color=color.new(#94a3b8, 50), linewidth=1)
p_bb_lower = plot(show_bb ? bb_lower : na, "BB Lower", color=color.new(#94a3b8, 50), linewidth=1)
fill(p_bb_upper, p_bb_lower, color=show_bb ? color.new(#334155, 92) : na, title="BB Channel Fill")

// Active Bracket Targets
plot(show_targets and strategy.position_size != 0 ? active_tp : na, "Take-Profit Level", color=color.new(#22c55e, 0), linewidth=2, style=plot.style_linebr)
plot(show_targets and strategy.position_size != 0 ? active_sl : na, "Stop-Loss Level", color=color.new(#ef4444, 0), linewidth=2, style=plot.style_linebr)

// Visual Entry Signal Shapes
plotshape(long_entry and strategy.position_size == 0, "Long Signal", shape.triangleup, location.belowbar, color.new(#22c55e, 0), size=size.small, text="BUY", textcolor=color.white)
plotshape(short_entry and strategy.position_size == 0, "Short Signal", shape.triangledown, location.abovebar, color.new(#ef4444, 0), size=size.small, text="SELL", textcolor=color.white)

// Background highlight during active trade
bgcolor(strategy.position_size > 0 ? color.new(#22c55e, 94) : strategy.position_size < 0 ? color.new(#ef4444, 94) : na, title="In Position Tint")

// =============================================================================
// ON-SCREEN PERFORMANCE HUD TABLE
// =============================================================================

var table hud = table.new(position.top_right, 2, 8, bgcolor=color.new(#0f172a, 15), border_color=color.new(#334155, 0), border_width=1)

if show_hud and barstate.islast
    // Header
    table.cell(hud, 0, 0, "SPX AI Bracket Strategy", bgcolor=color.new(#1e293b, 0), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "Coupled 2:1", bgcolor=color.new(#1e293b, 0), text_color=color.new(#38bdf8, 0), text_size=size.small)
    
    // Net Profit
    float net_pnl = strategy.netprofit
    color pnl_color = net_pnl >= 0 ? color.green : color.red
    table.cell(hud, 0, 1, "Net P&L (USD)", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(hud, 1, 1, str.tostring(net_pnl, "$#,###.##"), text_color=pnl_color, text_size=size.small)
    
    // Win Rate
    float wr = strategy.closedtrades > 0 ? (strategy.wintrades / strategy.closedtrades) * 100.0 : 0.0
    table.cell(hud, 0, 2, "Win Rate", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(hud, 1, 2, str.tostring(wr, "#.#") + "% (" + str.tostring(strategy.wintrades) + "/" + str.tostring(strategy.closedtrades) + ")", text_color=color.white, text_size=size.small)
    
    // Profit Factor
    float gross_win = strategy.grossprofit
    float gross_loss = math.abs(strategy.grossloss)
    float pf = gross_loss > 0 ? gross_win / gross_loss : (gross_win > 0 ? 99.0 : 0.0)
    table.cell(hud, 0, 3, "Profit Factor", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(hud, 1, 3, str.tostring(pf, "#.##"), text_color=pf >= 1.5 ? color.green : color.white, text_size=size.small)
    
    // Position State
    string pos_str = strategy.position_size > 0 ? "LONG (" + str.tostring(bars_in_trade) + "/6 bars)" : strategy.position_size < 0 ? "SHORT (" + str.tostring(bars_in_trade) + "/6 bars)" : "FLAT"
    color pos_color = strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray
    table.cell(hud, 0, 4, "Current Position", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(hud, 1, 4, pos_str, text_color=pos_color, text_size=size.small)
    
    // Open Trade Floating P&L
    float open_pnl = strategy.openprofit
    color open_color = open_pnl >= 0 ? color.green : color.red
    table.cell(hud, 0, 5, "Floating P&L", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(hud, 1, 5, strategy.position_size != 0 ? str.tostring(open_pnl, "$#,###.##") : "--", text_color=open_color, text_size=size.small)
    
    // Drift & Touch Probability
    table.cell(hud, 0, 6, "Expected 5m Drift", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(hud, 1, 6, str.tostring(r_1_drift * 10000.0, "#.##") + " bps", text_color=r_1_drift >= 0 ? color.green : color.red, text_size=size.small)
    
    table.cell(hud, 0, 7, "+3.0 pt Touch Prob", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(hud, 1, 7, str.tostring(cal_p_touch * 100.0, "#.#") + "%", text_color=cal_p_touch >= min_touch_prob ? color.green : color.white, text_size=size.small)
